{%- liquid
  assign form_id = 'NewsletterForm--' | append: block.id
  assign terms_enabled = false
  if section.settings.enable_terms == true
    assign terms_enabled = true
  endif
-%}
<div class="block-email-signup" {{ block.shopify_attributes }}>
  {% form 'customer', class: 'newsletter-form', id: form_id %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <div class="newsletter-form__field-wrapper animate-arrow">
      <div class="field">
        <input
          id="NewsletterEmail--{{ block.id }}"
          type="email"
          name="contact[email]"
          class="field-input email-input"
          value="{{ form.email }}"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="Newsletter-error--{{ block.id }}"
          {% elsif form.posted_successfully? %}
            aria-describedby="Newsletter-success--{{ block.id }}"
          {% endif %}
          placeholder="{{ 'newsletter.label' | t }}"
          required
        >
        <label class="field-label" for="NewsletterEmail--{{ block.id }}">
          {{ 'newsletter.label' | t }}
        </label>
        <button
          type="submit"
          class="newsletter-form__button field__button"
          name="commit"
          id="NewsletterSubscribe--{{ block.id }}"
          aria-label="{{ 'newsletter.button_label' | t }}"
          {% if terms_enabled %}
            disabled
          {% endif %}
        >
          {% render 'icon-arrow' %}
        </button>
      </div>

      {%- if terms_enabled -%}
        <div class="terms-cart">
          <input
            type="checkbox"
            id="SignupTerms--{{ block.id }}"
            name="termsCheckbox"
            value="1"
            data-terms-for="NewsletterSubscribe--{{ block.id }}"
          >
          <label for="SignupTerms--{{ block.id }}">{{ section.settings.terms_label }}</label>
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <small class="newsletter-form-message form-message" id="Newsletter-error--{{ block.id }}">
          {%- render 'icon-error' -%}
          {{- form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email -}}
        </small>
      {%- endif -%}
    </div>
    {%- if form.posted_successfully? -%}
      <h3
        class="newsletter-form-message newsletter-form-message--success form-message"
        id="Newsletter-success--{{ block.id }}"
        tabindex="-1"
        autofocus
      >
        {% render 'icon-success' -%}
        {{- 'newsletter.success' | t }}
      </h3>
    {%- endif -%}
  {% endform %}
</div>

{% javascript %}
  (function () {
    function syncTerms(checkbox) {
      var button = document.getElementById(checkbox.dataset.termsFor);
      if (button) button.disabled = !checkbox.checked;
    }

    document.addEventListener('change', function (event) {
      if (event.target.matches('[data-terms-for]')) syncTerms(event.target);
    });

    function init() {
      document.querySelectorAll('[data-terms-for]').forEach(syncTerms);
    }

    document.addEventListener('DOMContentLoaded', init);
    document.addEventListener('shopify:section:load', init);
    document.addEventListener('shopify:block:select', init);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:blocks.email_signup.name",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "t:blocks.email_signup.name"
    }
  ]
}
{% endschema %}
