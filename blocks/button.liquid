{%- liquid
  assign icon_size = block.settings.icon_size
  assign icon_width = icon_size | times: 3
  assign text_color = block.settings.text_color
  assign background_color = block.settings.background_color
  assign has_text_color = false
  if text_color != blank and text_color.alpha != 0
    assign has_text_color = true
  endif
  assign border_color = block.settings.border_color
  assign has_border_color = false
  if border_color != blank and border_color.alpha != 0
    assign has_border_color = true
  endif
  assign has_background_color = false
  if background_color != blank and background_color.alpha != 0
    assign has_background_color = true
  endif
  assign icon_color = block.settings.icon_color
  assign has_icon_color = false
  if icon_color != blank and icon_color.alpha != 0
    assign has_icon_color = true
  endif
-%}

{%- capture icon_markup -%}
  {%- if block.settings.recolor_icon -%}
    <span
      class="block-buttons__icon block-buttons__icon--mask"
      style="--icon-url: url('{{ block.settings.icon | image_url: width: icon_width }}');"
      aria-hidden="true"
    ></span>
  {%- else -%}
    {{- block.settings.icon | image_url: width: icon_width | image_tag: class: 'block-buttons__icon', alt: '', loading: 'lazy' -}}
  {%- endif -%}
{%- endcapture -%}

<div id="Buttons-{{ block.id }}" class="block-buttons block-buttons-{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if block.settings.button_label != blank -%}
    <a
      id="Button-{{ block.id }}"
      {% if block.settings.button_link == blank %}
        role="link" aria-disabled="true"
      {% else %}
        href="{{ block.settings.button_link }}" {% if block.settings.open_new_tab_1 %} target="_blank" {% endif %}
      {% endif %}
      class="button-arrow button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
    >
      {%- if block.settings.icon != blank and block.settings.icon_position == 'first' -%}
        {{- icon_markup -}}
      {%- endif -%}
      <span>{{- block.settings.button_label | escape -}}</span>
      {%- if block.settings.icon != blank and block.settings.icon_position == 'last' -%}
        {{- icon_markup -}}
      {%- endif -%}
    </a>
  {%- endif -%}
</div>

{%- if block.settings.icon != blank or has_text_color or has_background_color or has_border_color or block.settings.custom_font_size or block.settings.custom_border_radius or block.settings.border_width > 0 or block.settings.custom_padding or block.settings.custom_margin -%}
  {%- style -%}
    #Button-{{ block.id }} {
      {%- if block.settings.icon != blank %}
        gap: {{ block.settings.icon_spacing }}px;
      {%- endif %}
      {%- if has_text_color %}
        color: {{ text_color }};
      {%- endif %}
      {%- if has_background_color %}
        background-color: {{ background_color }};
      {%- endif %}
      {%- if block.settings.custom_font_size %}
        font-size: {{ block.settings.font_size_mobile | divided_by: 10.0 }}rem;
      {%- endif %}
      {%- if block.settings.custom_border_radius %}
        border-radius: {{ block.settings.border_radius }}px;
      {%- endif %}
      {%- if block.settings.border_width > 0 %}
        border-width: {{ block.settings.border_width }}px;
        border-style: solid;
        {%- unless has_border_color %}
          border-color: currentColor;
        {%- endunless %}
      {%- endif %}
      {%- if has_border_color %}
        border-color: {{ border_color }};
      {%- endif %}
    }
    {%- if block.settings.custom_padding %}
      #Button-{{ block.id }},
      #Button-{{ block.id }}:hover {
        min-height: 0;
        padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
      }
      @media screen and (min-width: 750px) {
        #Button-{{ block.id }},
        #Button-{{ block.id }}:hover {
          padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
        }
      }
    {%- endif %}
    {%- if block.settings.custom_font_size %}
      @media screen and (min-width: 750px) {
        #Button-{{ block.id }} {
          font-size: {{ block.settings.font_size | divided_by: 10.0 }}rem;
        }
      }
    {%- endif %}
    {%- if block.settings.icon != blank %}
      #Button-{{ block.id }} .block-buttons__icon {
        width: {{ icon_size }}px;
        height: {{ icon_size }}px;
      }
      {%- if block.settings.recolor_icon and has_icon_color %}
        #Button-{{ block.id }} .block-buttons__icon--mask {
          background-color: {{ icon_color }};
        }
      {%- endif %}
    {%- endif %}
    {%- if block.settings.custom_margin %}
      #Buttons-{{ block.id }} {
        margin: {{ block.settings.margin_top }}px {{ block.settings.margin_right }}px {{ block.settings.margin_bottom }}px {{ block.settings.margin_left }}px;
      }
    {%- endif %}
  {%- endstyle -%}
{%- endif -%}

{% stylesheet %}
  .block-buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 1rem;
    max-width: 45rem;
    word-break: break-word;
    position: relative;
    z-index: 3;
  }

  .block-buttons__icon {
    flex-shrink: 0;
    object-fit: contain;
  }

  .block-buttons__icon--mask {
    display: inline-block;
    background-color: currentColor;
    -webkit-mask: var(--icon-url) center / contain no-repeat;
    mask: var(--icon-url) center / contain no-repeat;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.button.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "default": "Button label",
      "label": "t:blocks.button.settings.button_label.label",
      "info": "t:blocks.button.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:blocks.button.settings.button_link.label"
    },
    {
      "type": "checkbox",
      "id": "apply_link_to_image",
      "default": false,
      "label": "t:sections.image-banner.blocks.buttons.settings.apply_link_to_image.label",
      "info": "t:blocks.button.settings.apply_link_to_image.info"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab_1",
      "default": false,
      "label": "t:sections.all.open_new_tab.label"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "default": false,
      "label": "t:sections.rich-text.blocks.buttons.settings.button_style_secondary_1.label"
    },
    {
      "type": "header",
      "content": "t:blocks.button.settings.header_style.content"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.button.settings.text_color.label",
      "info": "t:blocks.button.settings.text_color.info"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:blocks.button.settings.background_color.label",
      "info": "t:blocks.button.settings.background_color.info"
    },
    {
      "type": "checkbox",
      "id": "custom_font_size",
      "default": false,
      "label": "t:blocks.button.settings.custom_font_size.label"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "t:blocks.button.settings.font_size.label",
      "visible_if": "{{ block.settings.custom_font_size }}"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "t:blocks.button.settings.font_size_mobile.label",
      "visible_if": "{{ block.settings.custom_font_size }}"
    },
    {
      "type": "header",
      "content": "t:blocks.button.settings.header_border.content"
    },
    {
      "type": "checkbox",
      "id": "custom_border_radius",
      "default": false,
      "label": "t:blocks.button.settings.custom_border_radius.label",
      "info": "t:blocks.button.settings.custom_border_radius.info"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 6,
      "label": "t:blocks.button.settings.border_radius.label",
      "visible_if": "{{ block.settings.custom_border_radius }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0,
      "label": "t:blocks.button.settings.border_width.label"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.button.settings.border_color.label",
      "info": "t:blocks.button.settings.border_color.info"
    },
    {
      "type": "header",
      "content": "t:blocks.button.settings.header_padding.content"
    },
    {
      "type": "checkbox",
      "id": "custom_padding",
      "default": false,
      "label": "t:blocks.button.settings.custom_padding.label",
      "info": "t:blocks.button.settings.custom_padding.info"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "t:blocks.button.settings.padding_vertical.label",
      "visible_if": "{{ block.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 24,
      "label": "t:blocks.button.settings.padding_horizontal.label",
      "visible_if": "{{ block.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10,
      "label": "t:blocks.button.settings.padding_vertical_mobile.label",
      "visible_if": "{{ block.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "t:blocks.button.settings.padding_horizontal_mobile.label",
      "visible_if": "{{ block.settings.custom_padding }}"
    },
    {
      "type": "header",
      "content": "t:blocks.button.settings.header_margin.content"
    },
    {
      "type": "checkbox",
      "id": "custom_margin",
      "default": false,
      "label": "t:blocks.button.settings.custom_margin.label",
      "info": "t:blocks.button.settings.custom_margin.info"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:blocks.button.settings.margin_top.label",
      "visible_if": "{{ block.settings.custom_margin }}"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:blocks.button.settings.margin_bottom.label",
      "visible_if": "{{ block.settings.custom_margin }}"
    },
    {
      "type": "range",
      "id": "margin_left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:blocks.button.settings.margin_left.label",
      "visible_if": "{{ block.settings.custom_margin }}"
    },
    {
      "type": "range",
      "id": "margin_right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:blocks.button.settings.margin_right.label",
      "visible_if": "{{ block.settings.custom_margin }}"
    },
    {
      "type": "header",
      "content": "t:blocks.button.settings.header_icon.content"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:blocks.button.settings.icon.label"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "t:blocks.button.settings.icon_size.label"
    },
    {
      "type": "select",
      "id": "icon_position",
      "options": [
        {
          "value": "first",
          "label": "t:blocks.button.settings.icon_position.options__1.label"
        },
        {
          "value": "last",
          "label": "t:blocks.button.settings.icon_position.options__2.label"
        }
      ],
      "default": "last",
      "label": "t:blocks.button.settings.icon_position.label"
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8,
      "label": "t:blocks.button.settings.icon_spacing.label"
    },
    {
      "type": "checkbox",
      "id": "recolor_icon",
      "default": false,
      "label": "t:blocks.button.settings.recolor_icon.label",
      "info": "t:blocks.button.settings.recolor_icon.info"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:blocks.button.settings.icon_color.label",
      "info": "t:blocks.button.settings.icon_color.info",
      "visible_if": "{{ block.settings.recolor_icon }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.button.name"
    }
  ]
}
{% endschema %}
