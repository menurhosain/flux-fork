{%- liquid
  assign pill_collection = block.settings.collection
  assign pill_label = block.settings.label
  if pill_label == blank and pill_collection != blank
    assign pill_label = pill_collection.title
  endif

  assign pill_link = block.settings.link
  if pill_link == blank and pill_collection != blank
    assign pill_link = pill_collection.url
  endif

  assign is_active = false
  if collection and pill_collection != blank and block.settings.link == blank
    if collection.handle == pill_collection.handle
      assign is_active = true
    endif
  elsif pill_link != blank and request.path == pill_link
    assign is_active = true
  endif

  assign text_color = block.settings.text_color
  assign has_text_color = false
  if text_color != blank and text_color.alpha != 0
    assign has_text_color = true
  endif
  assign background_color = block.settings.background_color
  assign has_background_color = false
  if background_color != blank and background_color.alpha != 0
    assign has_background_color = true
  endif
  assign border_color = block.settings.border_color
  assign has_border_color = false
  if border_color != blank and border_color.alpha != 0
    assign has_border_color = true
  endif
-%}
{%- if pill_label != blank -%}
  {%- if pill_link != blank -%}
    <a
      id="CollectionPill-{{ block.id }}"
      href="{{ pill_link }}"
      class="collection-pill{% if is_active %} is-active{% endif %}"
      {% if is_active %}
        aria-current="page"
      {% endif %}
      {{ block.shopify_attributes }}
    >
      {{- pill_label | escape -}}
    </a>
  {%- else -%}
    <span id="CollectionPill-{{ block.id }}" class="collection-pill" {{ block.shopify_attributes }}>
      {{- pill_label | escape -}}
    </span>
  {%- endif -%}

  {%- if has_text_color or has_background_color or has_border_color or block.settings.font_weight != 'inherit' or block.settings.custom_font_size or block.settings.custom_border_width or block.settings.custom_padding -%}
    {%- style -%}
      .collection-pills #CollectionPill-{{ block.id }}.collection-pill {
        {%- if has_text_color %}
          color: {{ text_color }};
        {%- endif %}
        {%- if has_background_color %}
          background-color: {{ background_color }};
        {%- endif %}
        {%- if has_border_color %}
          border-color: {{ border_color }};
        {%- endif %}
        {%- if block.settings.custom_border_width %}
          border-width: {{ block.settings.border_width }}px;
        {%- endif %}
        {%- if block.settings.font_weight != 'inherit' %}
          font-weight: {{ block.settings.font_weight }};
        {%- endif %}
        {%- if block.settings.custom_font_size %}
          font-size: {{ block.settings.font_size_mobile | divided_by: 10.0 }}rem;
        {%- endif %}
        {%- if block.settings.custom_padding %}
          padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
        {%- endif %}
      }
      {%- if block.settings.custom_font_size or block.settings.custom_padding %}
        @media screen and (min-width: 750px) {
          .collection-pills #CollectionPill-{{ block.id }}.collection-pill {
            {%- if block.settings.custom_font_size %}
              font-size: {{ block.settings.font_size | divided_by: 10.0 }}rem;
            {%- endif %}
            {%- if block.settings.custom_padding %}
              padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
            {%- endif %}
          }
        }
      {%- endif %}
    {%- endstyle -%}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.collection_pill.name",
  "tag": null,
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:blocks.collection_pill.settings.collection.label"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.pill.settings.label.label",
      "info": "t:blocks.collection_pill.settings.label.info"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.pill.settings.link.label",
      "info": "t:blocks.collection_pill.settings.link.info"
    },
    {
      "type": "header",
      "content": "t:blocks.pill.settings.header_style.content",
      "info": "t:blocks.collection_pill.settings.header_style.info"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.pill.settings.text_color.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:blocks.pill.settings.background_color.label"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.pill.settings.border_color.label"
    },
    {
      "type": "checkbox",
      "id": "custom_border_width",
      "default": false,
      "label": "t:blocks.pill.settings.custom_border_width.label"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1,
      "label": "t:blocks.pill.settings.border_width.label",
      "visible_if": "{{ block.settings.custom_border_width }}"
    },
    {
      "type": "select",
      "id": "font_weight",
      "options": [
        {
          "value": "inherit",
          "label": "t:blocks.collection_pill.settings.font_weight.options__1.label"
        },
        {
          "value": "300",
          "label": "t:blocks.pill.settings.font_weight.options__2.label"
        },
        {
          "value": "400",
          "label": "t:blocks.pill.settings.font_weight.options__3.label"
        },
        {
          "value": "500",
          "label": "t:blocks.pill.settings.font_weight.options__4.label"
        },
        {
          "value": "600",
          "label": "t:blocks.pill.settings.font_weight.options__5.label"
        },
        {
          "value": "700",
          "label": "t:blocks.pill.settings.font_weight.options__6.label"
        }
      ],
      "default": "inherit",
      "label": "t:blocks.pill.settings.font_weight.label"
    },
    {
      "type": "checkbox",
      "id": "custom_font_size",
      "default": false,
      "label": "t:blocks.pill.settings.custom_font_size.label"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "t:blocks.pill.settings.font_size.label",
      "visible_if": "{{ block.settings.custom_font_size }}"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 13,
      "label": "t:blocks.pill.settings.font_size_mobile.label",
      "visible_if": "{{ block.settings.custom_font_size }}"
    },
    {
      "type": "checkbox",
      "id": "custom_padding",
      "default": false,
      "label": "t:blocks.collection_pill.settings.custom_padding.label"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10,
      "label": "t:blocks.pills.settings.padding_vertical.label",
      "visible_if": "{{ block.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "t:blocks.pills.settings.padding_horizontal.label",
      "visible_if": "{{ block.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8,
      "label": "t:blocks.pills.settings.padding_vertical_mobile.label",
      "visible_if": "{{ block.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_horizontal_mobile",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "t:blocks.pills.settings.padding_horizontal_mobile.label",
      "visible_if": "{{ block.settings.custom_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.collection_pill.name"
    }
  ]
}
{% endschema %}
