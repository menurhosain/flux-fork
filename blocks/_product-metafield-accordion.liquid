{%- liquid
  assign is_featured = false
  if section.settings.gallery_layout == blank
    assign is_featured = true
  endif

  assign metafield_path = block.settings.metafield | strip | split: '.'
  assign namespace = metafield_path | first
  assign key = metafield_path | last
  assign accordion_metafield = null
  if metafield_path.size == 2
    assign accordion_metafield = product.metafields[namespace][key]
  endif

  assign title_key = block.settings.title_field | strip
  assign content_key = block.settings.content_field | strip

  assign is_rich_text = false
  if block.settings.source == 'rich_text'
    assign is_rich_text = true
  endif

  if is_rich_text and accordion_metafield != blank
    assign split_open = '<' | append: block.settings.split_heading
    assign split_close = '</' | append: block.settings.split_heading | append: '>'
    assign rich_html = accordion_metafield | metafield_tag
    if rich_html contains '<div class="metafield-rich_text_field">'
      assign rich_html = rich_html | remove_first: '<div class="metafield-rich_text_field">' | remove_last: '</div>'
    endif
    unless rich_html contains split_open
      assign accordion_metafield = null
    endunless
  endif
-%}
{%- if accordion_metafield != blank -%}
  {%- unless is_featured -%}
    <div
      class="block{% if block.settings.hide_quick_view %} hide-quick-view{% endif %}"
      data-column="{{ block.settings.column }}"
      {{ block.shopify_attributes }}
    >
  {%- endunless -%}
  <div
    id="MetafieldAccordion-{{ block.id }}"
    class="section-{{ block.id }}-margin metafield-accordion metafield-accordion--{{ block.settings.border_style }}"
  >
    {%- if is_rich_text -%}
      {%- assign rich_chunks = rich_html | split: split_open -%}
      {%- assign row_index = 0 -%}
      {%- for chunk in rich_chunks offset: 1 -%}
        {%- liquid
          assign chunk_head = chunk | split: split_close | first
          assign head_attrs = chunk_head | split: '>' | first
          assign row_title = chunk_head | remove_first: head_attrs | remove_first: '>' | strip_html | strip
          assign row_content = chunk | remove_first: chunk_head | remove_first: split_close | strip
          assign row_index = row_index | plus: 1
        -%}
        {%- render 'product-metafield-accordion-row',
          row_title: row_title,
          row_content: row_content,
          index: row_index,
          block: block,
          section_id: section.id
        -%}
      {%- endfor -%}
    {%- elsif accordion_metafield.list? -%}
      {%- for entry in accordion_metafield.value -%}
        {%- render 'product-metafield-accordion-row',
          entry: entry,
          index: forloop.index,
          title_key: title_key,
          content_key: content_key,
          block: block,
          section_id: section.id
        -%}
      {%- endfor -%}
    {%- else -%}
      {%- render 'product-metafield-accordion-row',
        entry: accordion_metafield.value,
        index: 1,
        title_key: title_key,
        content_key: content_key,
        block: block,
        section_id: section.id
      -%}
    {%- endif -%}
  </div>
  {%- style -%}
    #MetafieldAccordion-{{ block.id }} {
      margin-top: {{ block.settings.margin_top }}px;
      --mfa-label-size: {{ block.settings.label_font_size_mobile }}px;
      --mfa-label-weight: {{ block.settings.label_font_weight }};
      --mfa-label-py: {{ block.settings.label_padding_vertical }}px;
      --mfa-label-px: {{ block.settings.label_padding_horizontal }}px;
      --mfa-content-size: {{ block.settings.content_font_size_mobile }}px;
      --mfa-content-weight: {{ block.settings.content_font_weight }};
      --mfa-content-line-height: {{ block.settings.content_line_height }};
      --mfa-content-py: {{ block.settings.content_padding_vertical }}px;
      --mfa-content-px: {{ block.settings.content_padding_horizontal }}px;
      --mfa-border-width: {{ block.settings.border_width }}px;
      --mfa-border-color: {{ block.settings.border_color }};
      --mfa-border-radius: {{ block.settings.border_radius }}px;
      --mfa-row-gap: {{ block.settings.row_gap }}px;
      {%- if block.settings.label_color != blank and block.settings.label_color.alpha != 0 %}
        --mfa-label-color: {{ block.settings.label_color }};
      {%- endif %}
      {%- if block.settings.label_background != blank and block.settings.label_background.alpha != 0 %}
        --mfa-label-bg: {{ block.settings.label_background }};
      {%- endif %}
      {%- if block.settings.content_color != blank and block.settings.content_color.alpha != 0 %}
        --mfa-content-color: {{ block.settings.content_color }};
      {%- endif %}
      {%- if block.settings.content_background != blank and block.settings.content_background.alpha != 0 %}
        --mfa-content-bg: {{ block.settings.content_background }};
      {%- endif %}
    }
    @media screen and (min-width: 750px) {
      #MetafieldAccordion-{{ block.id }} {
        --mfa-label-size: {{ block.settings.label_font_size }}px;
        --mfa-content-size: {{ block.settings.content_font_size }}px;
      }
    }
  {%- endstyle -%}
  {%- unless is_featured -%}
    </div>
  {%- endunless -%}

{%- elsif request.design_mode -%}
  <div class="metafield-accordion__placeholder" {{ block.shopify_attributes }}>
    {{ 'products.product.metafield_accordion_empty' | t: metafield: block.settings.metafield }}
  </div>
{%- endif -%}

{% stylesheet %}
  .metafield-accordion .metafield-accordion__row.accordion {
    margin: 0;
  }

  .metafield-accordion .metafield-accordion__row.accordion summary {
    padding: var(--mfa-label-py) var(--mfa-label-px);
    border-radius: 0;
    background: var(--mfa-label-bg, transparent);
    align-items: center;
  }

  .metafield-accordion .metafield-accordion__row .accordion__title {
    font-size: var(--mfa-label-size);
    font-weight: var(--mfa-label-weight);
    line-height: 1.3;
    color: var(--mfa-label-color, rgb(var(--color-foreground)));
  }

  .metafield-accordion .metafield-accordion__row summary .icon-caret,
  .metafield-accordion .metafield-accordion__row details[open] > summary .icon-caret,
  .metafield-accordion .metafield-accordion__row .icon-accordion {
    color: var(--mfa-label-color, rgb(var(--color-foreground)));
    fill: var(--mfa-label-color, rgb(var(--color-foreground)));
  }

  .metafield-accordion .metafield-accordion__row.accordion .accordion__content {
    padding: var(--mfa-content-py) var(--mfa-content-px);
    background: var(--mfa-content-bg, transparent);
  }

  .metafield-accordion .metafield-accordion__row .accordion__content,
  .metafield-accordion .metafield-accordion__row .accordion__content :is(p, li, span, strong, em, a) {
    font-size: var(--mfa-content-size);
    line-height: var(--mfa-content-line-height);
    font-weight: var(--mfa-content-weight);
    color: var(--mfa-content-color, rgba(var(--color-foreground), 0.75));
  }

  .metafield-accordion .metafield-accordion__row .accordion__content p {
    margin: 0 0 1rem;
  }

  .metafield-accordion .metafield-accordion__row .accordion__content > :last-child,
  .metafield-accordion .metafield-accordion__row .accordion__content > :last-child p:last-child {
    margin-bottom: 0;
  }

  .metafield-accordion .metafield-accordion__row.accordion details[open] .accordion__content {
    padding-bottom: calc(var(--mfa-content-py) + var(--mfa-label-py));
  }

  .metafield-accordion--divider .metafield-accordion__row {
    border-bottom: var(--mfa-border-width) solid var(--mfa-border-color);
  }

  .metafield-accordion--divider .metafield-accordion__row:first-child {
    border-top: var(--mfa-border-width) solid var(--mfa-border-color);
  }

  .metafield-accordion--boxed .metafield-accordion__row {
    border: var(--mfa-border-width) solid var(--mfa-border-color);
    border-radius: var(--mfa-border-radius);
    overflow: hidden;
  }

  .metafield-accordion--boxed .metafield-accordion__row + .metafield-accordion__row {
    margin-top: var(--mfa-row-gap);
    border-top: var(--mfa-border-width) solid var(--mfa-border-color);
  }

  .metafield-accordion__placeholder {
    padding: 1.2rem 1.6rem;
    border: 1px dashed rgba(var(--color-foreground), 0.3);
    border-radius: 0.6rem;
    font-size: 1.4rem;
    opacity: 0.7;
  }
{% endstylesheet %}

