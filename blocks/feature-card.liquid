{%- liquid
  assign icon_px = block.settings.icon_size
  assign icon_width = icon_px | times: 3
  assign has_icon = false
  if block.settings.icon != blank or block.settings.builtin_icon != 'none'
    assign has_icon = true
  endif

  assign background_color = block.settings.background_color
  assign has_background_color = false
  if background_color != blank and background_color.alpha != 0
    assign has_background_color = true
  endif
  assign border_color = block.settings.border_color
  assign has_border_color = false
  if border_color != blank and border_color.alpha != 0
    assign has_border_color = true
  endif
  assign icon_color = block.settings.icon_color
  assign has_icon_color = false
  if icon_color != blank and icon_color.alpha != 0
    assign has_icon_color = true
  endif
  assign icon_background = block.settings.icon_background
  assign has_icon_background = false
  if icon_background != blank and icon_background.alpha != 0
    assign has_icon_background = true
  endif
  assign title_color = block.settings.title_color
  assign has_title_color = false
  if title_color != blank and title_color.alpha != 0
    assign has_title_color = true
  endif
  assign text_color = block.settings.text_color
  assign has_text_color = false
  if text_color != blank and text_color.alpha != 0
    assign has_text_color = true
  endif
  assign number_color = block.settings.number_color
  assign has_number_color = false
  if number_color != blank and number_color.alpha != 0
    assign has_number_color = true
  endif
  assign link_color = block.settings.link_color
  assign has_link_color = false
  if link_color != blank and link_color.alpha != 0
    assign has_link_color = true
  endif
  assign arrow_color = block.settings.arrow_color
  assign has_arrow_color = false
  if arrow_color != blank and arrow_color.alpha != 0
    assign has_arrow_color = true
  endif
  assign divider_color = block.settings.divider_color
  assign has_divider_color = false
  if divider_color != blank and divider_color.alpha != 0
    assign has_divider_color = true
  endif

  assign is_numbered = false
  if block.settings.layout == 'numbered'
    assign is_numbered = true
  endif
  assign card_is_link = false
  if block.settings.card_link and block.settings.link != blank
    assign card_is_link = true
  endif
-%}

{%- capture icon_markup -%}
  {%- if has_icon -%}
    <div class="feature-card__icon{% if block.settings.round_icon %} feature-card__icon--round{% endif %}">
      {%- if block.settings.icon != blank -%}
        {%- if block.settings.recolor_icon -%}
          <span
            class="feature-card__icon-mask"
            style="--icon-url: url('{{ block.settings.icon | image_url: width: icon_width }}');"
            aria-hidden="true"
          ></span>
        {%- else -%}
          {{-
            block.settings.icon
            | image_url: width: icon_width
            | image_tag: class: 'feature-card__icon-image', alt: '', loading: 'lazy'
          -}}
        {%- endif -%}
      {%- else -%}
        {%- render 'feature-card-icon', icon: block.settings.builtin_icon -%}
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div
  id="FeatureCard-{{ block.id }}"
  class="feature-card feature-card--{{ block.settings.layout }}{% if block.settings.alignment == 'center' %} feature-card--center{% endif %}{% if block.settings.hover_effect %} feature-card--hover{% endif %}{% if card_is_link %} feature-card--linked{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- if card_is_link -%}
    <a
      href="{{ block.settings.link }}"
      class="feature-card__overlay-link"
      {% if block.settings.open_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
    >
      <span class="visually-hidden">
        {{- block.settings.link_label | default: block.settings.title | escape -}}
        {%- if block.settings.link_label != blank and block.settings.title != blank %}: {{ block.settings.title | escape }}{% endif -%}
      </span>
    </a>
  {%- endif -%}

  {%- if is_numbered -%}
    {%- if block.settings.number != blank or has_icon -%}
      <div class="feature-card__top">
        {%- if block.settings.number != blank -%}
          <span class="feature-card__number">{{ block.settings.number | escape }}</span>
        {%- endif -%}
        {{- icon_markup -}}
      </div>
    {%- endif -%}
  {%- else -%}
    {{- icon_markup -}}
  {%- endif -%}

  {%- if block.settings.title != blank -%}
    <{{ block.settings.title_tag }} class="feature-card__title">
      {{- block.settings.title | escape -}}
    </{{ block.settings.title_tag }}>
  {%- endif -%}

  {%- if block.settings.text != blank -%}
    <div class="feature-card__text rte">{{ block.settings.text }}</div>
  {%- endif -%}

  {%- if is_numbered == false and block.settings.number != blank -%}
    <span class="feature-card__number" aria-hidden="true">{{ block.settings.number | escape }}</span>
  {%- endif -%}

  {%- if block.settings.link_label != blank -%}
    <div class="feature-card__footer{% if block.settings.show_divider %} feature-card__footer--divider{% endif %}">
      {%- capture link_inner -%}
        <span class="feature-card__link-label">{{ block.settings.link_label | escape }}</span>
        {%- if block.settings.arrow != 'none' or block.settings.arrow_image != blank -%}
          <span class="feature-card__arrow" aria-hidden="true">
            {%- if block.settings.arrow_image != blank -%}
              <span
                class="feature-card__icon-mask"
                style="--icon-url: url('{{ block.settings.arrow_image | image_url: width: 60 }}');"
              ></span>
            {%- elsif block.settings.arrow == 'right' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg>
            {%- endif -%}
          </span>
        {%- endif -%}
      {%- endcapture -%}
      {%- if block.settings.link != blank and card_is_link == false -%}
        <a
          href="{{ block.settings.link }}"
          class="feature-card__link"
          {% if block.settings.open_new_tab %}
            target="_blank" rel="noopener"
          {% endif %}
        >
          {{- link_inner -}}
        </a>
      {%- else -%}
        <div class="feature-card__link">{{- link_inner -}}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if block.settings.show_accent_line -%}
    <div class="feature-card__accent" aria-hidden="true"><span></span></div>
  {%- endif -%}
</div>

{%- style -%}
  #FeatureCard-{{ block.id }} {
    padding: {{ block.settings.padding_mobile }}px;
    border-radius: {{ block.settings.border_radius }}px;
    min-height: {{ block.settings.min_height_mobile }}px;
    {%- if has_background_color %}
      background-color: {{ background_color }};
    {%- endif %}
    {%- if block.settings.border_width > 0 %}
      border: {{ block.settings.border_width }}px solid {% if has_border_color %}{{ border_color }}{% else %}rgba(var(--color-foreground), 0.1){% endif %};
    {%- endif %}
  }
  #FeatureCard-{{ block.id }} .feature-card__icon {
    width: {{ block.settings.icon_box_size }}px;
    height: {{ block.settings.icon_box_size }}px;
    border-radius: {{ block.settings.icon_box_radius }}px;
    margin-bottom: {{ block.settings.icon_spacing_mobile }}px;
    {%- if has_icon_background %}
      background-color: {{ icon_background }};
    {%- endif %}
    {%- if has_icon_color %}
      color: {{ icon_color }};
    {%- endif %}
  }
  #FeatureCard-{{ block.id }} .feature-card__icon > * {
    width: {{ icon_px }}px;
    height: {{ icon_px }}px;
  }
  #FeatureCard-{{ block.id }} .feature-card__top {
    margin-bottom: {{ block.settings.icon_spacing_mobile }}px;
  }
  #FeatureCard-{{ block.id }} .feature-card__footer {
    margin-top: {{ block.settings.footer_spacing }}px;
    padding-top: {{ block.settings.footer_padding }}px;
    {%- if has_divider_color %}
      border-top-color: {{ divider_color }};
    {%- endif %}
  }
  #FeatureCard-{{ block.id }} .feature-card__accent {
    padding-top: {{ block.settings.accent_spacing }}px;
  }
  #FeatureCard-{{ block.id }} .feature-card__accent span {
    width: {{ block.settings.accent_width }}px;
    height: {{ block.settings.accent_thickness }}px;
    {%- if block.settings.accent_color != blank %}
      background-color: {{ block.settings.accent_color }};
    {%- endif %}
  }
  #FeatureCard-{{ block.id }} .feature-card__link {
    font-size: {{ block.settings.link_size }}px;
    {%- if has_link_color %}
      color: {{ link_color }};
    {%- endif %}
  }
  #FeatureCard-{{ block.id }} .feature-card__arrow {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    {%- if has_arrow_color %}
      color: {{ arrow_color }};
    {%- endif %}
  }
  #FeatureCard-{{ block.id }} .feature-card__title {
    font-size: {{ block.settings.title_size_mobile }}px;
    {%- if block.settings.title_weight != 'inherit' %}
      font-weight: {{ block.settings.title_weight }};
    {%- endif %}
    {%- if has_title_color %}
      color: {{ title_color }};
    {%- endif %}
  }
  #FeatureCard-{{ block.id }} .feature-card__text {
    font-size: {{ block.settings.text_size_mobile | divided_by: 10.0 }}rem;
    {%- if has_text_color %}
      color: {{ text_color }};
    {%- endif %}
  }
  #FeatureCard-{{ block.id }} .feature-card__number {
    font-size: {{ block.settings.number_size_mobile | divided_by: 10.0 }}rem;
    font-family: var(--font-{{ block.settings.number_font }}-family);
    {%- if has_number_color %}
      color: {{ number_color }};
    {%- endif %}
  }
  @media screen and (min-width: 750px) {
    #FeatureCard-{{ block.id }} {
      padding: {{ block.settings.padding }}px;
      min-height: {{ block.settings.min_height }}px;
    }
    #FeatureCard-{{ block.id }} .feature-card__icon {
      margin-bottom: {{ block.settings.icon_spacing }}px;
    }
    #FeatureCard-{{ block.id }} .feature-card__top {
      margin-bottom: {{ block.settings.icon_spacing }}px;
    }
    #FeatureCard-{{ block.id }} .feature-card__title {
      font-size: {{ block.settings.title_size }}px;
    }
    #FeatureCard-{{ block.id }} .feature-card__text {
      font-size: {{ block.settings.text_size | divided_by: 10.0 }}rem;
    }
    #FeatureCard-{{ block.id }} .feature-card__number {
      font-size: {{ block.settings.number_size | divided_by: 10.0 }}rem;
    }
  }
  {%- if block.settings.number_badge %}
    #FeatureCard-{{ block.id }} .feature-card__number {
      display: inline-flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      width: {{ block.settings.number_badge_size }}px;
      height: {{ block.settings.number_badge_size }}px;
      border-radius: 50%;
      background-color: {{ block.settings.number_badge_background }};
      font-size: {{ block.settings.number_badge_font_size }}px;
      font-weight: 600;
      line-height: 1;
    }
  {%- endif %}
{%- endstyle -%}

{% stylesheet %}
  .feature-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    text-align: left;
    background-color: rgb(var(--color-background));
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .feature-card--hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -20px rgba(0, 0, 0, 0.25);
  }

  .feature-card__icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    color: rgb(var(--color-foreground));
    background-color: rgba(var(--color-foreground), 0.08);
  }

  .feature-card__icon-image {
    object-fit: contain;
  }

  .feature-card__icon-mask {
    display: block;
    background-color: currentColor;
    -webkit-mask: var(--icon-url) center / contain no-repeat;
    mask: var(--icon-url) center / contain no-repeat;
  }

  .feature-card__title {
    position: relative;
    z-index: 1;
    margin: 0 0 1.6rem;
    font-family: var(--font-heading-family);
    line-height: 1.1;
  }

  .feature-card__text {
    position: relative;
    z-index: 1;
    line-height: 1.65;
    color: rgba(var(--color-foreground), 0.75);
  }

  .feature-card__text > :first-child {
    margin-top: 0;
  }

  .feature-card__text > :last-child {
    margin-bottom: 0;
  }

  .feature-card__icon--round {
    border-radius: 50% !important;
  }

  .feature-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.6rem;
  }

  .feature-card--numbered .feature-card__icon {
    margin-bottom: 0 !important;
    margin-left: auto;
  }

  .feature-card--numbered .feature-card__number {
    position: static;
    line-height: 1;
    color: rgb(var(--color-foreground));
    pointer-events: auto;
    user-select: auto;
  }

  .feature-card__overlay-link {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  .feature-card__footer {
    position: relative;
    z-index: 1;
    margin-top: auto;
    border-top: 0 solid rgba(var(--color-foreground), 0.12);
  }

  .feature-card__footer--divider {
    border-top-width: 1px;
  }

  .feature-card__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
    color: rgb(var(--color-foreground));
    text-decoration: none;
  }

  .feature-card__arrow {
    display: inline-flex;
    flex-shrink: 0;
    color: #107af8;
    transition: transform 0.3s ease;
  }

  .feature-card__arrow > * {
    width: 100%;
    height: 100%;
  }

  .feature-card__link:hover .feature-card__arrow,
  .feature-card--linked:hover .feature-card__arrow {
    transform: translate(2px, -2px);
  }

  .feature-card--center {
    align-items: center;
    text-align: center;
  }

  .feature-card--center .feature-card__footer {
    align-self: stretch;
  }

  .feature-card__accent {
    position: relative;
    z-index: 1;
    margin-top: auto;
  }

  .feature-card__footer ~ .feature-card__accent {
    margin-top: 0;
  }

  .feature-card__accent span {
    display: block;
    border-radius: 999px;
    background-color: rgba(var(--color-foreground), 0.3);
  }

  .feature-card__number {
    position: absolute;
    right: 1.6rem;
    bottom: 10px;
    line-height: 0.9;
    color: rgba(var(--color-foreground), 0.1);
    pointer-events: none;
    user-select: none;
  }
{% endstylesheet %}

{% schema %}
