  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "classic",
          "label": "t:blocks.feature_card.settings.layout.options__1.label"
        },
        {
          "value": "numbered",
          "label": "t:blocks.feature_card.settings.layout.options__2.label"
        }
      ],
      "default": "classic",
      "label": "t:blocks.feature_card.settings.layout.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
