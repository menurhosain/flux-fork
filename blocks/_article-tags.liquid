<div class="tags" {{ block.shopify_attributes }}>
  {%- for tag in article.tags -%}
    <a class="link" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
    {%- unless forloop.last %} {% endunless %}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "t:sections.main-article.blocks.tags.name",
  "tag": null,
  "settings": [],
  "presets": [
    {
      "name": "t:sections.main-article.blocks.tags.name"
    }
  ]
}
{% endschema %}
