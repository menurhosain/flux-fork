<div class="section-heading-block" {{ block.shopify_attributes }}>
  {% render 'section-heading-content', settings: block.settings, id: block.id %}
</div>

{% schema %}
{
  "name": "t:blocks.section-heading.name",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "default": "Subheading",
      "label": "t:sections.section-heading.settings.subheading.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Section heading",
      "label": "t:sections.section-heading.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Use this area to introduce the content that follows.</p>",
      "label": "t:sections.section-heading.settings.description.label"
    },
    {
      "type": "header",
      "content": "t:sections.section-heading.settings.header_layout.content"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.section-heading.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.section-heading.settings.alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.section-heading.settings.alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.section-heading.settings.alignment.label"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 300,
      "max": 1300,
      "step": 10,
      "unit": "px",
      "default": 720,
      "label": "t:sections.section-heading.settings.max_width.label"
    },
    {
      "type": "range",
      "id": "gap_subheading",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12,
      "label": "t:sections.section-heading.settings.gap_subheading.label"
    },
    {
      "type": "range",
      "id": "gap_subheading_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 8,
      "label": "t:sections.section-heading.settings.gap_subheading_mobile.label"
    },
    {
      "type": "range",
      "id": "gap_heading",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16,
      "label": "t:sections.section-heading.settings.gap_heading.label"
    },
    {
      "type": "range",
      "id": "gap_heading_mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 12,
      "label": "t:sections.section-heading.settings.gap_heading_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.section-heading.settings.header_subheading.content"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 13,
      "label": "t:sections.section-heading.settings.font_size.label"
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "t:sections.section-heading.settings.font_size_mobile.label"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "t:sections.section-heading.settings.color.label",
      "info": "t:sections.section-heading.settings.color.info"
    },
    {
      "type": "checkbox",
      "id": "subheading_uppercase",
      "default": true,
      "label": "t:sections.section-heading.settings.subheading_uppercase.label"
    },
    {
      "type": "header",
      "content": "t:sections.section-heading.settings.header_heading.content"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40,
      "label": "t:sections.section-heading.settings.font_size.label"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 12,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 30,
      "label": "t:sections.section-heading.settings.font_size_mobile.label"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:sections.section-heading.settings.color.label",
      "info": "t:sections.section-heading.settings.color.info"
    },
    {
      "type": "select",
      "id": "heading_font",
      "options": [
        {
          "value": "heading",
          "label": "t:blocks.heading.settings.font_family.options__1.label"
        },
        {
          "value": "body",
          "label": "t:blocks.heading.settings.font_family.options__2.label"
        }
      ],
      "default": "heading",
      "label": "t:blocks.heading.settings.font_family.label"
    },
    {
      "type": "header",
      "content": "t:sections.section-heading.settings.header_description.content"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "t:sections.section-heading.settings.font_size.label"
    },
    {
      "type": "range",
      "id": "description_size_mobile",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 15,
      "label": "t:sections.section-heading.settings.font_size_mobile.label"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "t:sections.section-heading.settings.color.label",
      "info": "t:sections.section-heading.settings.color.info"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.section-heading.name"
    }
  ]
}
{% endschema %}
