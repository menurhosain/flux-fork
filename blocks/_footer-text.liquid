{%- liquid
  for item in section.blocks
    if item.id == block.id
      assign block_index = forloop.index
      break
    endif
  endfor
-%}
<div
  class="footer-block grid-item{% if block.settings.column_width > 0 %} footer-block--custom-width{% endif %} {% if section.settings.swipe_on_mobile %} slider-slide{% endif %}"
  id="Slide-{{ section.id }}-{{ block_index }}"
  {%- if block.settings.column_width > 0 %} style="--footer-col-width: {{ block.settings.column_width }};"{% endif %}
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <h2 class="footer-block__heading heading-bold">{{- block.settings.heading | escape -}}</h2>
  {%- endif -%}

  <div class="footer-block__details-content rte">
    {{ block.settings.subtext }}
    {{ block.settings.custom_liquid }}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.footer.blocks.text.name",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.footer.blocks.column_width.header"
    },
    {
      "type": "range",
      "id": "column_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0,
      "label": "t:sections.footer.blocks.column_width.label",
      "info": "t:sections.footer.blocks.column_width.info"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Heading",
      "label": "t:sections.footer.blocks.text.settings.heading.label"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "default": "<p>Share contact information, store details, and brand content with your customers.</p>",
      "label": "t:sections.footer.blocks.text.settings.subtext.label"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.main-product.blocks.custom_liquid.settings.custom_liquid.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.blocks.text.name"
    }
  ]
}
{% endschema %}
