{%- if block.settings.text != blank -%}
  <div
    id="Text-{{ block.id }}"
    class="block-text rte {{ block.settings.text_style }}"
    {{ block.shopify_attributes }}
  >
    {{ block.settings.text }}
  </div>
{%- endif -%}

{%- liquid
  assign text_color = block.settings.text_color
  assign has_text_color = false
  if text_color != blank and text_color.alpha != 0
    assign has_text_color = true
  endif
-%}
{%- if block.settings.custom_font_size or has_text_color or block.settings.custom_spacing or block.settings.alignment != 'inherit' -%}
  {%- style -%}
    {%- if block.settings.alignment != 'inherit' %}
      #Text-{{ block.id }}, #Text-{{ block.id }} :is(p, ul, ol) {
        text-align: {{ block.settings.alignment }};
      }
    {%- endif %}
    {%- if has_text_color or block.settings.custom_spacing %}
      #Text-{{ block.id }} {
        {%- if has_text_color %}
          --color-foreground: {{ text_color.red }}, {{ text_color.green }}, {{ text_color.blue }};
          color: {{ text_color }};
        {%- endif %}
        {%- if block.settings.custom_spacing %}
          margin-top: {{ block.settings.margin_top }}px;
          margin-bottom: {{ block.settings.margin_bottom }}px;
          margin-left: {{ block.settings.margin_left }}px;
          margin-right: {{ block.settings.margin_right }}px;
        {%- endif %}
      }
    {%- endif %}
    {%- if has_text_color %}
      #Text-{{ block.id }} :is(p, li, a, strong, em) {
        color: {{ text_color }};
      }
    {%- endif %}
    {%- if block.settings.custom_font_size %}
      #Text-{{ block.id }},
      #Text-{{ block.id }} :is(p, ul, ol, li) {
        font-size: {{ block.settings.font_size_mobile | divided_by: 10.0 }}rem;
      }
      @media screen and (min-width: 750px) {
        #Text-{{ block.id }},
        #Text-{{ block.id }} :is(p, ul, ol, li) {
          font-size: {{ block.settings.font_size | divided_by: 10.0 }}rem;
        }
      }
    {%- endif %}
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.text.name",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>",
      "label": "t:sections.image-banner.blocks.text.settings.text.label"
    },
    {
      "type": "select",
      "id": "text_style",
      "options": [
        {
          "value": "body",
          "label": "t:sections.image-banner.blocks.text.settings.text_style.options__1.label"
        },
        {
          "value": "subtitle",
          "label": "t:sections.image-banner.blocks.text.settings.text_style.options__2.label"
        },
        {
          "value": "caption-with-letter-spacing",
          "label": "t:sections.image-banner.blocks.text.settings.text_style.options__3.label"
        }
      ],
      "default": "body",
      "label": "t:sections.image-banner.blocks.text.settings.text_style.label"
    },
    {
      "type": "header",
      "content": "t:blocks.text.settings.header_typography.content"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "inherit",
          "label": "t:blocks.text.settings.alignment.options__1.label"
        },
        {
          "value": "left",
          "label": "t:blocks.text.settings.alignment.options__2.label"
        },
        {
          "value": "center",
          "label": "t:blocks.text.settings.alignment.options__3.label"
        },
        {
          "value": "right",
          "label": "t:blocks.text.settings.alignment.options__4.label"
        }
      ],
      "default": "inherit",
      "label": "t:blocks.text.settings.alignment.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.text.settings.text_color.label",
      "info": "t:blocks.text.settings.text_color.info"
    },
    {
      "type": "checkbox",
      "id": "custom_font_size",
      "default": false,
      "label": "t:blocks.text.settings.custom_font_size.label",
      "info": "t:blocks.text.settings.custom_font_size.info"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "t:blocks.text.settings.font_size.label",
      "visible_if": "{{ block.settings.custom_font_size }}"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 15,
      "label": "t:blocks.text.settings.font_size_mobile.label",
      "visible_if": "{{ block.settings.custom_font_size }}"
    },
    {
      "type": "header",
      "content": "t:blocks.text.settings.header_spacing.content"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "default": false,
      "label": "t:blocks.text.settings.custom_spacing.label",
      "info": "t:blocks.text.settings.custom_spacing.info"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:blocks.text.settings.margin_top.label",
      "visible_if": "{{ block.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16,
      "label": "t:blocks.text.settings.margin_bottom.label",
      "visible_if": "{{ block.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:blocks.text.settings.margin_left.label",
      "visible_if": "{{ block.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:blocks.text.settings.margin_right.label",
      "visible_if": "{{ block.settings.custom_spacing }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.text.name"
    }
  ]
}
{% endschema %}
