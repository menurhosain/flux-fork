        },
        {
          "value": "leaf",
          "label": "t:blocks.feature_card.settings.builtin_icon.options__leaf.label"
        },
        {
          "value": "moon",
          "label": "t:blocks.feature_card.settings.builtin_icon.options__moon.label"
        },
        {
          "value": "sun",
          "label": "t:blocks.feature_card.settings.builtin_icon.options__sun.label"
        },
        {
          "value": "compass",
