          "value": "check",
          "label": "t:blocks.feature_card.settings.builtin_icon.options__check.label"
        },
        {
          "value": "chat",
          "label": "t:blocks.feature_card.settings.builtin_icon.options__chat.label"
        },
        {
          "value": "star",
          "label": "t:blocks.feature_card.settings.builtin_icon.options__star.label"
        },
        {
          "value": "clipboard",
          "label": "t:blocks.feature_card.settings.builtin_icon.options__clipboard.label"
        },
        {
          "value": "flask",
          "label": "t:blocks.feature_card.settings.builtin_icon.options__flask.label"
