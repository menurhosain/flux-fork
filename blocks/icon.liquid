{%- liquid
  assign icon_width = block.settings.icon_size | times: 3
  assign has_icon = false
  if block.settings.icon != blank or block.settings.builtin_icon != 'none'
    assign has_icon = true
  endif
-%}

{%- if has_icon -%}
  <div
    id="IconBlock-{{ block.id }}"
    class="icon-block icon-block--{{ block.settings.alignment }}"
    {{ block.shopify_attributes }}
  >
    <div class="icon-block__box icon-block__box--{{ block.settings.shape }}">
      {%- if block.settings.icon != blank -%}
        {%- if block.settings.recolor_icon -%}
          <span
            class="icon-block__mask"
            style="--icon-url: url('{{ block.settings.icon | image_url: width: icon_width }}');"
            aria-hidden="true"
          ></span>
        {%- else -%}
          {{-
            block.settings.icon
            | image_url: width: icon_width
            | image_tag: class: 'icon-block__image', alt: '', loading: 'lazy'
          -}}
        {%- endif -%}
      {%- else -%}
        {%- render 'feature-card-icon', icon: block.settings.builtin_icon -%}
      {%- endif -%}
    </div>
  </div>

  {%- style -%}
    #IconBlock-{{ block.id }} {
      margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
    }
    #IconBlock-{{ block.id }} .icon-block__box {
      width: {{ block.settings.width_mobile }}px;
      height: {{ block.settings.height_mobile }}px;
      color: {{ block.settings.icon_color }};
      background-color: {{ block.settings.background_color }};
      {%- if block.settings.shape == 'rounded' %}
        border-radius: {{ block.settings.border_radius }}px;
      {%- endif %}
      {%- if block.settings.border_width > 0 %}
        border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
      {%- endif %}
    }
    #IconBlock-{{ block.id }} .icon-block__box > * {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }
    @media screen and (min-width: 750px) {
      #IconBlock-{{ block.id }} {
        margin-bottom: {{ block.settings.margin_bottom }}px;
      }
      #IconBlock-{{ block.id }} .icon-block__box {
        width: {{ block.settings.width }}px;
        height: {{ block.settings.height }}px;
      }
      #IconBlock-{{ block.id }} .icon-block__box > * {
        width: {{ block.settings.icon_size }}px;
        height: {{ block.settings.icon_size }}px;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% stylesheet %}
  .icon-block {
    display: flex;
  }

  .icon-block--left {
    justify-content: flex-start;
  }

  .icon-block--center {
    justify-content: center;
  }

  .icon-block--right {
    justify-content: flex-end;
  }

  .icon-block--inherit {
    display: block;
  }

  .icon-block--inherit .icon-block__box {
    display: inline-flex;
  }

  .icon-block__box {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .icon-block__box--circle {
    border-radius: 50%;
  }

  .icon-block__box--square {
    border-radius: 0;
  }

  .icon-block__image {
    object-fit: contain;
  }

  .icon-block__mask {
    display: block;
    background-color: currentColor;
    -webkit-mask: var(--icon-url) center / contain no-repeat;
    mask: var(--icon-url) center / contain no-repeat;
  }
{% endstylesheet %}

