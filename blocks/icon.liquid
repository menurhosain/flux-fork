      "default": "circle",
      "label": "t:blocks.icon.settings.shape.label"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 16,
      "label": "t:blocks.feature_card.settings.icon_box_radius.label",
      "visible_if": "{{ block.settings.shape == 'rounded' }}"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
