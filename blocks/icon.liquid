    {
      "type": "color",
      "id": "background_color",
      "default": "#eceaf8",
      "label": "t:blocks.feature_card.settings.icon_background.label"
    },
    {
      "type": "range",
      "id": "width",
      "min": 16,
      "max": 216,
      "step": 2,
      "unit": "px",
      "default": 96,
      "label": "t:blocks.icon.settings.width.label"
    },
    {
      "type": "range",
      "id": "height",
