      "label": "t:blocks.feature_card.settings.builtin_icon.label"
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "t:blocks.feature_card.settings.icon.label",
      "info": "t:blocks.feature_card.settings.icon.info"
    },
    {
      "type": "checkbox",
      "id": "recolor_icon",
      "default": true,
      "label": "t:blocks.feature_card.settings.recolor_icon.label",
      "info": "t:blocks.feature_card.settings.recolor_icon.info"
