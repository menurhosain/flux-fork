{%- if block.settings.caption != blank -%}
  <p
    id="Caption-{{ block.id }}"
    class="block-caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }}"
    {{ block.shopify_attributes }}
  >
    {{ block.settings.caption | escape }}
  </p>
{%- endif -%}

{%- liquid
  assign text_color = block.settings.text_color
  assign has_text_color = false
  if text_color != blank and text_color.alpha != 0
    assign has_text_color = true
  endif
  assign background_color = block.settings.background_color
  assign has_background = false
  if background_color != blank and background_color.alpha != 0
    assign has_background = true
  endif
-%}
{%- if block.settings.custom_font_size or has_text_color or block.settings.custom_spacing or block.settings.alignment != 'inherit' or has_background or block.settings.border_radius > 0 or block.settings.custom_padding or block.settings.font_weight != 'inherit' or block.settings.custom_letter_spacing -%}
  {%- style -%}
    {%- if block.settings.alignment != 'inherit' %}
      #Caption-{{ block.id }} {
        text-align: {{ block.settings.alignment }};
      }
    {%- endif %}
    #Caption-{{ block.id }} {
      {%- if block.settings.custom_font_size %}
        font-size: {{ block.settings.font_size_mobile | divided_by: 10.0 }}rem;
      {%- endif %}
      {%- if has_text_color %}
        color: {{ text_color }};
      {%- endif %}
      {%- if block.settings.font_weight != 'inherit' %}
        font-weight: {{ block.settings.font_weight }};
      {%- endif %}
      {%- if block.settings.custom_letter_spacing %}
        letter-spacing: {{ block.settings.letter_spacing }}px;
      {%- endif %}
      {%- if block.settings.custom_spacing %}
        margin-top: {{ block.settings.margin_top }}px;
        margin-bottom: {{ block.settings.margin_bottom }}px;
        margin-left: {{ block.settings.margin_left }}px;
        margin-right: {{ block.settings.margin_right }}px;
      {%- endif %}
      {%- if has_background %}
        background-color: {{ background_color }};
        width: fit-content;
        max-width: 100%;
        {%- unless block.settings.custom_spacing %}
          {%- case block.settings.alignment %}
            {%- when 'center' %}
              margin-left: auto;
              margin-right: auto;
            {%- when 'right' %}
              margin-left: auto;
          {%- endcase %}
        {%- endunless %}
      {%- endif %}
      {%- if block.settings.border_radius > 0 %}
        border-radius: {{ block.settings.border_radius }}px;
      {%- endif %}
      {%- if block.settings.custom_padding %}
        padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
      {%- endif %}
    }
    {%- if block.settings.custom_font_size %}
      @media screen and (min-width: 750px) {
        #Caption-{{ block.id }} {
          font-size: {{ block.settings.font_size | divided_by: 10.0 }}rem;
        }
      }
    {%- endif %}
  {%- endstyle -%}
{%- endif -%}

