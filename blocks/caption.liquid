{%- if block.settings.caption != blank -%}
  <p
    id="Caption-{{ block.id }}"
    class="block-caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }}"
    {{ block.shopify_attributes }}
  >
    {{ block.settings.caption | escape }}
  </p>
{%- endif -%}

{%- liquid
  assign text_color = block.settings.text_color
  assign has_text_color = false
  if text_color != blank and text_color.alpha != 0
    assign has_text_color = true
  endif
-%}
{%- if block.settings.custom_font_size or has_text_color or block.settings.custom_spacing or block.settings.alignment != 'inherit' -%}
  {%- style -%}
    {%- if block.settings.alignment != 'inherit' %}
      #Caption-{{ block.id }} {
        text-align: {{ block.settings.alignment }};
      }
    {%- endif %}
    #Caption-{{ block.id }} {
      {%- if block.settings.custom_font_size %}
        font-size: {{ block.settings.font_size_mobile | divided_by: 10.0 }}rem;
      {%- endif %}
      {%- if has_text_color %}
        color: {{ text_color }};
      {%- endif %}
      {%- if block.settings.custom_spacing %}
        margin-top: {{ block.settings.margin_top }}px;
        margin-bottom: {{ block.settings.margin_bottom }}px;
        margin-left: {{ block.settings.margin_left }}px;
        margin-right: {{ block.settings.margin_right }}px;
      {%- endif %}
    }
    {%- if block.settings.custom_font_size %}
      @media screen and (min-width: 750px) {
        #Caption-{{ block.id }} {
          font-size: {{ block.settings.font_size | divided_by: 10.0 }}rem;
        }
      }
    {%- endif %}
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.caption.name",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "default": "Add a tagline",
      "label": "t:sections.rich-text.blocks.caption.settings.text.label"
    },
    {
      "type": "select",
      "id": "text_style",
      "options": [
        {
          "value": "subtitle",
          "label": "t:sections.rich-text.blocks.caption.settings.text_style.options__1.label"
        },
        {
          "value": "caption-with-letter-spacing",
          "label": "t:sections.rich-text.blocks.caption.settings.text_style.options__2.label"
        }
      ],
      "default": "caption-with-letter-spacing",
      "label": "t:sections.rich-text.blocks.caption.settings.text_style.label"
    },
    {
      "type": "select",
      "id": "text_size",
      "options": [
        {
          "value": "small",
          "label": "t:sections.rich-text.blocks.caption.settings.caption_size.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.rich-text.blocks.caption.settings.caption_size.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.rich-text.blocks.caption.settings.caption_size.options__3.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.rich-text.blocks.caption.settings.caption_size.label"
    },
    {
      "type": "header",
      "content": "t:blocks.caption.settings.header_typography.content"
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "inherit",
          "label": "t:blocks.caption.settings.alignment.options__1.label"
        },
        {
          "value": "left",
          "label": "t:blocks.caption.settings.alignment.options__2.label"
        },
        {
          "value": "center",
          "label": "t:blocks.caption.settings.alignment.options__3.label"
        },
        {
          "value": "right",
          "label": "t:blocks.caption.settings.alignment.options__4.label"
        }
      ],
      "default": "inherit",
      "label": "t:blocks.caption.settings.alignment.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.caption.settings.text_color.label",
      "info": "t:blocks.caption.settings.text_color.info"
    },
    {
      "type": "checkbox",
      "id": "custom_font_size",
      "default": false,
      "label": "t:blocks.caption.settings.custom_font_size.label",
      "info": "t:blocks.caption.settings.custom_font_size.info"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "t:blocks.caption.settings.font_size.label",
      "visible_if": "{{ block.settings.custom_font_size }}"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 13,
      "label": "t:blocks.caption.settings.font_size_mobile.label",
      "visible_if": "{{ block.settings.custom_font_size }}"
    },
    {
      "type": "header",
      "content": "t:blocks.caption.settings.header_spacing.content"
    },
    {
      "type": "checkbox",
      "id": "custom_spacing",
      "default": false,
      "label": "t:blocks.caption.settings.custom_spacing.label",
      "info": "t:blocks.caption.settings.custom_spacing.info"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:blocks.caption.settings.margin_top.label",
      "visible_if": "{{ block.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 8,
      "label": "t:blocks.caption.settings.margin_bottom.label",
      "visible_if": "{{ block.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:blocks.caption.settings.margin_left.label",
      "visible_if": "{{ block.settings.custom_spacing }}"
    },
    {
      "type": "range",
      "id": "margin_right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0,
      "label": "t:blocks.caption.settings.margin_right.label",
      "visible_if": "{{ block.settings.custom_spacing }}"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.caption.name"
    }
  ]
}
{% endschema %}
