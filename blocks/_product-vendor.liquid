{%- liquid
  assign product = closest.product
  assign is_featured = false
  if section.settings.gallery_layout == blank
    assign is_featured = true
  endif
-%}
{%- capture block_attributes -%}{% if is_featured %}{{ block.shopify_attributes }}{% endif %}{%- endcapture -%}
{%- unless is_featured -%}
  <div
    class="block{% if block.settings.hide_mobile %} hide-mobile{% endif %}{% if block.settings.hide_desktop %} hide-desktop{% endif %}{% if block.settings.hide_quick_view %} hide-quick-view{% endif %}{% if block.settings.pin_to_top %} pin-to-top__hide{% endif %}"
    data-column="{{ block.settings.column }}"
    {{ block.shopify_attributes }}
  >
{%- endunless -%}
<p
  class="section-{{ block.id }}-margin vendor product-text caption-with-letter-spacing"
  {{ block_attributes }}
>
  {% if block.settings.enable_vendor_link == true %}
      <a href="{{ routes.collections_url }}/vendors?q={{ product.vendor | url_encode }}">
        {{ product.vendor | escape }}
      </a>
    {%- else -%}
      {{ product.vendor | escape }}
  {%- endif -%}
</p>
{%- unless is_featured -%}
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "t:sections.main-product.blocks.vendor.name",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "column",
      "options": [
        {
          "value": "left",
          "label": "t:sections.main-product.blocks.title.settings.column.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.main-product.blocks.title.settings.column.options__2.label"
        },
        {
          "value": "under-gallery",
          "label": "t:sections.main-product.blocks.title.settings.column.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.main-product.blocks.title.settings.column.label"
    },
    {
      "type": "checkbox",
      "id": "enable_vendor_link",
      "default": false,
      "label": "t:sections.main-product.blocks.vendor.settings.enable_vendor_link.label"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "t:sections.main-product.blocks.title.settings.margin_top.label",
      "default": 10
    },
    {
      "type": "header",
      "content": "t:sections.main-product.blocks.payment_enable.settings.header_quick_view.content",
      "info": "t:sections.main-product.blocks.payment_enable.settings.header_quick_view.info"
    },
    {
      "type": "checkbox",
      "id": "hide_quick_view",
      "default": false,
      "label": "t:sections.main-product.blocks.payment_enable.settings.hide_quick_view.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured-collection.settings.header_mobile.content"
    },
    {
      "type": "checkbox",
      "id": "pin_to_top",
      "default": false,
      "label": "t:sections.main-product.blocks.title.settings.pin_to_top.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-product.blocks.vendor.name"
    }
  ]
}
{% endschema %}
