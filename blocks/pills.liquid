  ],
  "presets": [
    {
      "name": "t:blocks.pills.name",
      "blocks": [
        {
          "type": "_pill",
          "settings": {
            "label": "Low energy"
          }
        },
        {
          "type": "_pill",
          "settings": {
            "label": "Better sleep"
          }
        },
        {
          "type": "_pill",
          "settings": {
            "label": "Stress support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
