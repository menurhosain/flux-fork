{%- liquid
  assign text_color = block.settings.text_color
  assign has_text_color = false
  if text_color != blank and text_color.alpha != 0
    assign has_text_color = true
  endif
  assign background_color = block.settings.background_color
  assign has_background_color = false
  if background_color != blank and background_color.alpha != 0
    assign has_background_color = true
  endif
  assign border_color = block.settings.border_color
  assign has_border_color = false
  if border_color != blank and border_color.alpha != 0
    assign has_border_color = true
  endif
  assign hover_text_color = block.settings.hover_text_color
  assign has_hover_text_color = false
  if hover_text_color != blank and hover_text_color.alpha != 0
    assign has_hover_text_color = true
  endif
  assign hover_background_color = block.settings.hover_background_color
  assign has_hover_background_color = false
  if hover_background_color != blank and hover_background_color.alpha != 0
    assign has_hover_background_color = true
  endif
  assign hover_border_color = block.settings.hover_border_color
  assign has_hover_border_color = false
  if hover_border_color != blank and hover_border_color.alpha != 0
    assign has_hover_border_color = true
  endif
-%}

<div
  id="Pills-{{ block.id }}"
  class="block-pills block-pills--{{ block.settings.alignment }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{%- style -%}
  #Pills-{{ block.id }} {
    gap: {{ block.settings.row_gap_mobile }}px {{ block.settings.column_gap_mobile }}px;
    {%- if block.settings.custom_spacing %}
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    {%- endif %}
  }
  #Pills-{{ block.id }} .block-pills__pill {
    padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    border-radius: {{ block.settings.border_radius }}px;
    border-width: {{ block.settings.border_width }}px;
    font-size: {{ block.settings.font_size_mobile | divided_by: 10.0 }}rem;
    {%- if block.settings.font_weight != 'inherit' %}
      font-weight: {{ block.settings.font_weight }};
    {%- endif %}
    {%- if has_text_color %}
      color: {{ text_color }};
    {%- endif %}
    {%- if has_background_color %}
      background-color: {{ background_color }};
    {%- endif %}
    {%- if has_border_color %}
      border-color: {{ border_color }};
    {%- endif %}
  }
  {%- if has_hover_text_color or has_hover_background_color or has_hover_border_color %}
    #Pills-{{ block.id }} .block-pills__pill:hover {
      {%- if has_hover_text_color %}
        color: {{ hover_text_color }};
      {%- endif %}
      {%- if has_hover_background_color %}
        background-color: {{ hover_background_color }};
      {%- endif %}
      {%- if has_hover_border_color %}
        border-color: {{ hover_border_color }};
      {%- endif %}
    }
  {%- endif %}
  @media screen and (min-width: 750px) {
    #Pills-{{ block.id }} {
      gap: {{ block.settings.row_gap }}px {{ block.settings.column_gap }}px;
    }
    #Pills-{{ block.id }} .block-pills__pill {
      padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
      font-size: {{ block.settings.font_size | divided_by: 10.0 }}rem;
    }
  }
{%- endstyle -%}

{% stylesheet %}
  .block-pills {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
  }

  .block-pills--left {
    justify-content: flex-start;
  }

  .block-pills--center {
    justify-content: center;
  }

  .block-pills--right {
    justify-content: flex-end;
  }

  .block-pills__pill {
    display: inline-flex;
    align-items: center;
    border-style: solid;
    border-color: rgba(var(--color-foreground), 0.12);
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
  }

  .block-pills__pill:hover {
    border-color: rgba(var(--color-foreground), 0.4);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.pills.name",
  "tag": null,
  "blocks": [
    {
      "type": "_pill"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "t:blocks.pills.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.pills.settings.alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:blocks.pills.settings.alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:blocks.pills.settings.alignment.label"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "t:blocks.pills.settings.column_gap.label"
    },
    {
      "type": "range",
      "id": "row_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12,
      "label": "t:blocks.pills.settings.row_gap.label"
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8,
      "label": "t:blocks.pills.settings.column_gap_mobile.label"
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8,
      "label": "t:blocks.pills.settings.row_gap_mobile.label"
    },
    {
      "type": "header",
      "content": "t:blocks.pills.settings.header_pill.content"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:blocks.pills.settings.text_color.label",
      "info": "t:blocks.pills.settings.text_color.info"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:blocks.pills.settings.background_color.label",
      "info": "t:blocks.pills.settings.background_color.info"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.pills.settings.border_color.label",
      "info": "t:blocks.pills.settings.border_color.info"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1,
      "label": "t:blocks.pills.settings.border_width.label"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 40,
      "label": "t:blocks.pills.settings.border_radius.label"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 15,
      "label": "t:blocks.pills.settings.font_size.label"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "t:blocks.pills.settings.font_size_mobile.label"
    },
    {
      "type": "select",
      "id": "font_weight",
      "options": [
        {
          "value": "inherit",
          "label": "t:blocks.pills.settings.font_weight.options__1.label"
        },
        {
          "value": "300",
          "label": "t:blocks.pills.settings.font_weight.options__2.label"
        },
        {
          "value": "400",
          "label": "t:blocks.pills.settings.font_weight.options__3.label"
        },
        {
          "value": "500",
          "label": "t:blocks.pills.settings.font_weight.options__4.label"
        },
        {
          "value": "600",
          "label": "t:blocks.pills.settings.font_weight.options__5.label"
        },
        {
          "value": "700",
          "label": "t:blocks.pills.settings.font_weight.options__6.label"
        }
      ],
      "default": "500",
      "label": "t:blocks.pills.settings.font_weight.label"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 14,
      "label": "t:blocks.pills.settings.padding_vertical.label"
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16,
      "label": "t:blocks.pills.settings.padding_horizontal.label"
    },
    {
      "type": "range",
      "id": "padding_vertical_mobile",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 10,
      "label": "t:blocks.pills.settings.padding_vertical_mobile.label"
    },
    {
