      "default": 14,
      "label": "t:blocks.pills.settings.padding_horizontal_mobile.label"
    },
    {
      "type": "header",
      "content": "t:blocks.pills.settings.header_hover.content"
    },
    {
      "type": "color",
      "id": "hover_text_color",
      "label": "t:blocks.pills.settings.hover_text_color.label"
    },
    {
      "type": "color",
      "id": "hover_background_color",
      "label": "t:blocks.pills.settings.hover_background_color.label"
    },
    {
      "type": "color",
      "id": "hover_border_color",
      "label": "t:blocks.pills.settings.hover_border_color.label",
      "info": "t:blocks.pills.settings.hover_border_color.info"
    },
    {
      "type": "header",
      "content": "t:blocks.pills.settings.header_spacing.content"
    },
    {
