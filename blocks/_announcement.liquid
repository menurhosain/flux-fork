<a
  class="announcement-slide"
  style="--announcement-icon-size: {{ block.settings.icon_size }}px;"
  {{ block.shopify_attributes }}
  {% if block.settings.slider_link != blank %}
    href="{{ block.settings.slider_link }}"
  {% else %}
    data-disabled="true"
    role="link"
    aria-disabled="true"
  {% endif %}>  
  <div class="announcement-text">{{ block.settings.slider-text }}</div>
  {%- if block.settings.custom_icon != blank -%}
    {{
      block.settings.custom_icon
      | image_url: width: 120
      | image_tag:
        class: 'announcement-icon announcement-icon--image',
        height: block.settings.icon_size,
        width: block.settings.icon_size,
        alt: '',
        loading: 'lazy'
    }}
  {%- elsif block.settings.icon != 'none' -%}
    <span class="announcement-icon" aria-hidden="true">
      {%- render 'icon-accordion', icon: block.settings.icon -%}
    </span>
  {%- endif -%}
</a>

