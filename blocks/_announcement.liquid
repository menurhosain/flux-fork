<a
  class="announcement-slide"
  {{ block.shopify_attributes }}
  {% if block.settings.slider_link != blank %}
    href="{{ block.settings.slider_link }}"
  {% else %}
    data-disabled="true"
    role="link"
    aria-disabled="true"
  {% endif %}>  
  <div class="announcement-text">{{ block.settings.slider-text }}</div>
</a>

{% schema %}
{
  "name": "announcement",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "slider-text",
      "default": "<p>Your Announcement</p>",
      "label": "t:sections.announcement-bar.blocks.announcement.settings.slider-text.label"
    },
    {
      "type": "url",
      "id": "slider_link",
      "label": "t:sections.announcement-bar.blocks.announcement.settings.slider-link.label"
    }
  ],
  "presets": [
    {
      "name": "announcement"
    }
  ]
}
{% endschema %}
