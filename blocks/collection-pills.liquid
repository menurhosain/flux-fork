{%- liquid
  assign text_color = block.settings.text_color
  assign has_text_color = false
  if text_color != blank and text_color.alpha != 0
    assign has_text_color = true
  endif
  assign background_color = block.settings.background_color
  assign has_background_color = false
  if background_color != blank and background_color.alpha != 0
    assign has_background_color = true
  endif
  assign border_color = block.settings.border_color
  assign has_border_color = false
  if border_color != blank and border_color.alpha != 0
    assign has_border_color = true
  endif
  assign hover_text_color = block.settings.hover_text_color
  assign has_hover_text_color = false
  if hover_text_color != blank and hover_text_color.alpha != 0
    assign has_hover_text_color = true
  endif
  assign hover_background_color = block.settings.hover_background_color
  assign has_hover_background_color = false
  if hover_background_color != blank and hover_background_color.alpha != 0
    assign has_hover_background_color = true
  endif
  assign hover_border_color = block.settings.hover_border_color
  assign has_hover_border_color = false
  if hover_border_color != blank and hover_border_color.alpha != 0
    assign has_hover_border_color = true
  endif
  assign active_text_color = block.settings.active_text_color
  assign has_active_text_color = false
  if active_text_color != blank and active_text_color.alpha != 0
    assign has_active_text_color = true
  endif
  assign active_background_color = block.settings.active_background_color
  assign has_active_background_color = false
  if active_background_color != blank and active_background_color.alpha != 0
    assign has_active_background_color = true
  endif
  assign active_border_color = block.settings.active_border_color
  assign has_active_border_color = false
  if active_border_color != blank and active_border_color.alpha != 0
    assign has_active_border_color = true
  endif
-%}

<nav
  id="CollectionPills-{{ block.id }}"
  class="collection-pills collection-pills--{{ block.settings.alignment }}{% if block.settings.mobile_scroll %} collection-pills--scroll{% endif %}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</nav>

{%- style -%}
  #CollectionPills-{{ block.id }} {
    gap: {{ block.settings.row_gap_mobile }}px {{ block.settings.column_gap_mobile }}px;
    {%- if block.settings.custom_spacing %}
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: {{ block.settings.margin_bottom }}px;
    {%- endif %}
  }
  #CollectionPills-{{ block.id }} .collection-pill {
    padding: {{ block.settings.padding_vertical_mobile }}px {{ block.settings.padding_horizontal_mobile }}px;
    border-radius: {{ block.settings.border_radius }}px;
    border-width: {{ block.settings.border_width }}px;
    font-size: {{ block.settings.font_size_mobile | divided_by: 10.0 }}rem;
    {%- if block.settings.font_weight != 'inherit' %}
      font-weight: {{ block.settings.font_weight }};
    {%- endif %}
    {%- if has_text_color %}
      color: {{ text_color }};
    {%- endif %}
    {%- if has_background_color %}
      background-color: {{ background_color }};
    {%- endif %}
    {%- if has_border_color %}
      border-color: {{ border_color }};
    {%- endif %}
  }
  {%- if has_hover_text_color or has_hover_background_color or has_hover_border_color %}
    #CollectionPills-{{ block.id }} .collection-pill:not(.is-active):hover {
      {%- if has_hover_text_color %}
        color: {{ hover_text_color }};
      {%- endif %}
      {%- if has_hover_background_color %}
        background-color: {{ hover_background_color }};
      {%- endif %}
      {%- if has_hover_border_color %}
        border-color: {{ hover_border_color }};
      {%- endif %}
    }
  {%- endif %}
  {%- if has_active_text_color or has_active_background_color or has_active_border_color %}
    #CollectionPills-{{ block.id }} .collection-pill.is-active {
      {%- if has_active_text_color %}
        color: {{ active_text_color }};
      {%- endif %}
      {%- if has_active_background_color %}
        background-color: {{ active_background_color }};
      {%- endif %}
      {%- if has_active_border_color %}
        border-color: {{ active_border_color }};
      {%- endif %}
    }
  {%- endif %}
  @media screen and (min-width: 750px) {
    #CollectionPills-{{ block.id }} {
      gap: {{ block.settings.row_gap }}px {{ block.settings.column_gap }}px;
    }
    #CollectionPills-{{ block.id }} .collection-pill {
      padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
      font-size: {{ block.settings.font_size | divided_by: 10.0 }}rem;
    }
  }
{%- endstyle -%}

{% stylesheet %}
  .collection-pills {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
  }

  .collection-pills--left {
    justify-content: flex-start;
  }

  .collection-pills--center {
    justify-content: center;
  }

  .collection-pills--right {
    justify-content: flex-end;
  }

  @media screen and (max-width: 749px) {
    .collection-pills--scroll {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .collection-pills--scroll::-webkit-scrollbar {
      display: none;
    }
  }

  .collection-pill {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    border-style: solid;
    border-color: rgba(var(--color-foreground), 0.12);
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
  }

  .collection-pill:not(.is-active):hover {
    border-color: rgba(var(--color-foreground), 0.4);
  }

  .collection-pill.is-active {
    background-color: rgb(var(--color-foreground));
    border-color: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }
{% endstylesheet %}

