{%- liquid
  assign highest_ratio = 0
  for item in section.blocks
    if item.settings.image.aspect_ratio > highest_ratio
      assign highest_ratio = item.settings.image.aspect_ratio
    endif
  endfor
-%}
{%- liquid
  for item in section.blocks
    if item.id == block.id
      assign block_index = forloop.index
      break
    endif
  endfor
-%}
{%- assign empty_column = '' -%}
{%- if block.settings.image == blank
  and block.settings.title == blank
  and block.settings.text == blank
  and block.settings.link_label == blank
  and block.settings.video_url == blank
-%}
  {%- assign empty_column = ' multicolumn-list-item--empty' -%}
{%- endif -%}

<li
  id="Slide-{{ section.id }}-{{ block_index }}"
  class="multicolumn-list-item grid-item{% if section.settings.swipe_on_mobile %} slider-slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}"
  {{ block.shopify_attributes }}
>
  <div class="color-{{ section.settings.color_scheme_1 }} gradient multicolumn-card {% if section.settings.enable_card_background == false %} card-content-container-transparent{% endif %} {% if section.settings.enable_card_background == true %} card-content-container{% endif %}">

   {% if block.settings.hide_image != true %}
    {%- if block.settings.image != blank -%}
      {% if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle' %}
        {% assign spaced_image = true %}
      {% endif %}

      <div class="multicolumn-card-image-wrapper multicolumn-card-image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
        <div
          class="media media--transparent {% if section.settings.enable_card_background == true %}global-media-settings{% endif %} media--{{ section.settings.image_ratio }}"
          {% if section.settings.image_ratio == 'adapt' %}
            style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
          {% endif %}
        >
          {%- capture sizes -%}(min-width: 990px) {% if section.blocks.size <= 2 %}710px{% else %}550px{% endif %}, (min-width: 750px) {% if section.blocks.size == 1 %}710px{% else %}550px{% endif %}, calc(100vw - 30px){%- endcapture -%}
          {{
            block.settings.image
            | image_url: width: 1420
            | image_tag:
              loading: 'lazy',
              sizes: sizes,
              widths: '275, 550, 710, 1420',
              class: 'multicolumn-card__image'
          }}
        </div>
      </div>

      {%- elsif block.settings.video_url != blank -%}                  
        {%- if block.settings.disable_autoplay -%}
        <div class="video-bg custom-video-wrapper" data-block-id="{{ block.id }}">
          {% assign video_preview = block.settings.video_url | video_tag: image_size: '1920x', autoplay: false, loop: true, controls: false %}
            {% assign video_preview_large = video_preview | replace: '_small.jpg', '_large.jpg' %}
            {{ video_preview_large }}
            <button class="video-toggle-btn video-icon deferred-media-poster-button motion-reduce" type="button">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-play" fill="none" viewBox="0 0 16 16">
                <path fill-rule="evenodd" clip-rule="evenodd" d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z" fill="currentColor"></path>
              </svg>
              <span class="video-icon-sonar"></span>
            </button>
        </div>              

        {%- else -%}
        <div class="video-bg custom-video-wrapper">
          {{ block.settings.video_url | video_tag: autoplay: true, loop: true, controls: false }}
        </div>
        {%- endif -%}                
    {%- else -%}
      <div class="multicolumn-card-image-wrapper multicolumn-card-image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
        <div
          class="media media--transparent {% if section.settings.enable_card_background == true %}global-media-settings{% endif %} media--{{ section.settings.image_ratio }}"
          {% if section.settings.image_ratio == 'adapt' %}
            style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
          {% endif %}
        >
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      </div>
    {% endif %}
  {%- endif -%}


    <div class="multicolumn-card-info">
      {%- if block.settings.title != blank -%}
        <h3 class="heading-bold">{{ block.settings.title | escape }}</h3>
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <div class="rte">{{ block.settings.text }}</div>
      {%- endif -%}
      {%- if block.settings.link_label != blank -%}
        <a
          class="button-arrow button"
          {% if block.settings.link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ block.settings.link }}" {% if block.settings.open_new_tab_1 %} target="_blank" {% endif %}
          {% endif %}
        >
          {{- block.settings.link_label | escape -}}
          {%- if settings.show_button_arrow -%}{% render 'icon-slider-arrows' %}{% endif %}
        </a>
      {%- endif -%}
    </div>
  </div>
</li>

{% schema %}
{
  "name": "t:sections.multicolumn.blocks.column.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.multicolumn.blocks.column.settings.image.label"
    },
    {
      "type": "checkbox",
      "id": "hide_image",
      "default": false,
      "label": "t:sections.multicolumn.blocks.column.settings.hide_image.label"
    },
    {
      "type": "video",
      "id": "video_url",
      "label": "t:sections.video-background.settings.video_url.label"
    },
    {
      "type": "checkbox",
      "id": "disable_autoplay",
      "default": false,
      "label": "Disable autoplay"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Column",
      "label": "t:sections.multicolumn.blocks.column.settings.title.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
      "label": "t:sections.multicolumn.blocks.column.settings.text.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.multicolumn.blocks.column.settings.link_label.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.multicolumn.blocks.column.settings.link.label"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab_1",
      "default": false,
      "label": "t:sections.all.open_new_tab.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.multicolumn.blocks.column.name"
    }
  ]
}
{% endschema %}
