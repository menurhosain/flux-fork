      "label": "t:sections.multicolumn.blocks.column.settings.margin_left.label",
      "visible_if": "{{ block.settings.title_custom_margin }}"
    },
    {
      "type": "number",
      "id": "title_margin_right",
      "default": 0,
      "label": "t:sections.multicolumn.blocks.column.settings.margin_right.label",
      "visible_if": "{{ block.settings.title_custom_margin }}"
    },
    {
      "type": "color",
