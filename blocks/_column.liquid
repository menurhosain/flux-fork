{%- liquid
  assign highest_ratio = 0
  for item in section.blocks
    if item.settings.image.aspect_ratio > highest_ratio
      assign highest_ratio = item.settings.image.aspect_ratio
    endif
  endfor
-%}
{%- liquid
  for item in section.blocks
    if item.id == block.id
      assign block_index = forloop.index
      break
    endif
  endfor
-%}
{%- assign empty_column = '' -%}
{%- if block.settings.image == blank
  and block.settings.title == blank
  and block.settings.subheading == blank
  and block.settings.text == blank
  and block.settings.link_label == blank
  and block.settings.video_url == blank
-%}
  {%- assign empty_column = ' multicolumn-list-item--empty' -%}
{%- endif -%}

<li
  id="Slide-{{ section.id }}-{{ block_index }}"
  class="multicolumn-list-item grid-item{% if section.settings.swipe_on_mobile %} slider-slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}"
  {{ block.shopify_attributes }}
>
  <div class="color-{{ section.settings.color_scheme_1 }} gradient multicolumn-card {% if section.settings.enable_card_background == false %} card-content-container-transparent{% endif %} {% if section.settings.enable_card_background == true %} card-content-container{% endif %}">

   {% if block.settings.hide_image != true %}
    {%- if block.settings.image != blank -%}
      {% if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle' %}
        {% assign spaced_image = true %}
      {% endif %}

      <div class="multicolumn-card-image-wrapper multicolumn-card-image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
        <div
          class="media media--transparent {% if section.settings.enable_card_background == true %}global-media-settings{% endif %} media--{{ section.settings.image_ratio }}"
          {% if section.settings.image_ratio == 'adapt' %}
            style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
          {% endif %}
        >
          {%- capture sizes -%}(min-width: 990px) {% if section.blocks.size <= 2 %}710px{% else %}550px{% endif %}, (min-width: 750px) {% if section.blocks.size == 1 %}710px{% else %}550px{% endif %}, calc(100vw - 30px){%- endcapture -%}
          {{
            block.settings.image
            | image_url: width: 1420
            | image_tag:
              loading: 'lazy',
              sizes: sizes,
              widths: '275, 550, 710, 1420',
              class: 'multicolumn-card__image'
          }}
        </div>
      </div>

      {%- elsif block.settings.video_url != blank -%}                  
        {%- if block.settings.disable_autoplay -%}
        <div class="video-bg custom-video-wrapper" data-block-id="{{ block.id }}">
          {% assign video_preview = block.settings.video_url | video_tag: image_size: '1920x', autoplay: false, loop: true, controls: false %}
            {% assign video_preview_large = video_preview | replace: '_small.jpg', '_large.jpg' %}
            {{ video_preview_large }}
            <button class="video-toggle-btn video-icon deferred-media-poster-button motion-reduce" type="button">
              <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-play" fill="none" viewBox="0 0 16 16">
                <path fill-rule="evenodd" clip-rule="evenodd" d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z" fill="currentColor"></path>
              </svg>
              <span class="video-icon-sonar"></span>
            </button>
        </div>              

        {%- else -%}
        <div class="video-bg custom-video-wrapper">
          {{ block.settings.video_url | video_tag: autoplay: true, loop: true, controls: false }}
        </div>
        {%- endif -%}                
    {%- else -%}
      <div class="multicolumn-card-image-wrapper multicolumn-card-image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
        <div
          class="media media--transparent {% if section.settings.enable_card_background == true %}global-media-settings{% endif %} media--{{ section.settings.image_ratio }}"
          {% if section.settings.image_ratio == 'adapt' %}
            style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
          {% endif %}
        >
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      </div>
    {% endif %}
  {%- endif -%}


    <div id="ColumnInfo-{{ block.id }}" class="multicolumn-card-info">
      {%- if block.settings.subheading != blank and block.settings.subheading_position == 'before' -%}
        <p class="multicolumn-card__subheading multicolumn-card__subheading--before subtitle">{{ block.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if block.settings.title != blank -%}
        <h3 class="multicolumn-card__title heading-bold">{{ block.settings.title | escape }}</h3>
      {%- endif -%}
      {%- if block.settings.subheading != blank and block.settings.subheading_position == 'after' -%}
        <p class="multicolumn-card__subheading multicolumn-card__subheading--after subtitle">{{ block.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <div class="multicolumn-card__text rte">{{ block.settings.text }}</div>
      {%- endif -%}
      {%- if block.settings.link_label != blank -%}
        <a
          class="button-arrow button"
          {% if block.settings.link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ block.settings.link }}" {% if block.settings.open_new_tab_1 %} target="_blank" {% endif %}
          {% endif %}
        >
          {{- block.settings.link_label | escape -}}
          {%- if settings.show_button_arrow -%}{% render 'icon-slider-arrows' %}{% endif %}
        </a>
      {%- endif -%}
    </div>
  </div>
</li>

{%- style -%}
    {%- liquid
      assign el_color = block.settings.title_color
      assign el_has_color = false
      if el_color != blank and el_color.alpha != 0
        assign el_has_color = true
      endif
    -%}
    {%- liquid
      assign el_bg = block.settings.title_background_color
      assign el_has_bg = false
      if el_bg != blank and el_bg.alpha != 0
        assign el_has_bg = true
      endif
    -%}
    {%- liquid
      assign title_radius = block.settings.title_border_radius | default: 0 | at_least: 0 | at_most: 200
    -%}
    {%- if el_has_bg or title_radius > 0 or block.settings.title_custom_padding %}
      #ColumnInfo-{{ block.id }} .multicolumn-card__title {
        {%- if el_has_bg %}
          background-color: {{ el_bg }};
        {%- endif %}
        {%- if title_radius > 0 %}
          border-radius: {{ title_radius }}px;
        {%- endif %}
        {%- if block.settings.title_custom_padding %}
          padding: {{ block.settings.title_padding_top | default: 0 | at_least: 0 }}px {{ block.settings.title_padding_right | default: 0 | at_least: 0 }}px {{ block.settings.title_padding_bottom | default: 0 | at_least: 0 }}px {{ block.settings.title_padding_left | default: 0 | at_least: 0 }}px;
        {%- endif %}
      }
    {%- endif %}
    {%- if el_has_color or block.settings.title_custom_margin %}
      #ColumnInfo-{{ block.id }} .multicolumn-card__title {
        {%- if el_has_color %}
          color: {{ el_color }};
        {%- endif %}
        {%- if block.settings.title_custom_margin %}
          margin: {{ block.settings.title_margin_top | default: 0 }}px {{ block.settings.title_margin_right | default: 0 }}px {{ block.settings.title_margin_bottom | default: 0 }}px {{ block.settings.title_margin_left | default: 0 }}px;
        {%- endif %}
      }
    {%- endif %}
    {%- if block.settings.title_custom_font_size %}
      #ColumnInfo-{{ block.id }} .multicolumn-card__title {
        font-size: {{ block.settings.title_font_size_mobile | divided_by: 10.0 }}rem;
      }
      @media screen and (min-width: 750px) {
        #ColumnInfo-{{ block.id }} .multicolumn-card__title {
          font-size: {{ block.settings.title_font_size | divided_by: 10.0 }}rem;
        }
      }
    {%- endif %}
    {%- liquid
      assign el_color = block.settings.subheading_color
      assign el_has_color = false
      if el_color != blank and el_color.alpha != 0
        assign el_has_color = true
      endif
    -%}
    {%- liquid
      assign el_bg = block.settings.subheading_background_color
      assign el_has_bg = false
      if el_bg != blank and el_bg.alpha != 0
        assign el_has_bg = true
      endif
    -%}
    {%- if el_has_bg or block.settings.subheading_border_radius > 0 or block.settings.subheading_custom_padding %}
      #ColumnInfo-{{ block.id }} .multicolumn-card__subheading {
        {%- if el_has_bg %}
          background-color: {{ el_bg }};
        {%- endif %}
        {%- if block.settings.subheading_border_radius > 0 %}
          border-radius: {{ block.settings.subheading_border_radius }}px;
        {%- endif %}
        {%- if block.settings.subheading_custom_padding %}
          padding: {{ block.settings.subheading_padding_top | default: 0 | at_least: 0 }}px {{ block.settings.subheading_padding_right | default: 0 | at_least: 0 }}px {{ block.settings.subheading_padding_bottom | default: 0 | at_least: 0 }}px {{ block.settings.subheading_padding_left | default: 0 | at_least: 0 }}px;
        {%- endif %}
      }
    {%- endif %}
    {%- if el_has_color or block.settings.subheading_custom_margin %}
      #ColumnInfo-{{ block.id }} .multicolumn-card__subheading {
        {%- if el_has_color %}
          color: {{ el_color }};
        {%- endif %}
        {%- if block.settings.subheading_custom_margin %}
          margin: {{ block.settings.subheading_margin_top | default: 0 }}px {{ block.settings.subheading_margin_right | default: 0 }}px {{ block.settings.subheading_margin_bottom | default: 0 }}px {{ block.settings.subheading_margin_left | default: 0 }}px;
        {%- endif %}
      }
    {%- endif %}
    {%- if block.settings.subheading_custom_font_size %}
      #ColumnInfo-{{ block.id }} .multicolumn-card__subheading {
        font-size: {{ block.settings.subheading_font_size_mobile | divided_by: 10.0 }}rem;
      }
      @media screen and (min-width: 750px) {
        #ColumnInfo-{{ block.id }} .multicolumn-card__subheading {
          font-size: {{ block.settings.subheading_font_size | divided_by: 10.0 }}rem;
        }
      }
    {%- endif %}
    {%- liquid
      assign el_color = block.settings.text_color
      assign el_has_color = false
      if el_color != blank and el_color.alpha != 0
        assign el_has_color = true
      endif
    -%}
    {%- liquid
      assign el_bg = block.settings.text_background_color
      assign el_has_bg = false
      if el_bg != blank and el_bg.alpha != 0
        assign el_has_bg = true
      endif
    -%}
    {%- if el_has_bg or block.settings.text_border_radius > 0 or block.settings.text_custom_padding %}
      #ColumnInfo-{{ block.id }} .multicolumn-card__text {
        {%- if el_has_bg %}
          background-color: {{ el_bg }};
        {%- endif %}
        {%- if block.settings.text_border_radius > 0 %}
          border-radius: {{ block.settings.text_border_radius }}px;
        {%- endif %}
        {%- if block.settings.text_custom_padding %}
          padding: {{ block.settings.text_padding_top | default: 0 | at_least: 0 }}px {{ block.settings.text_padding_right | default: 0 | at_least: 0 }}px {{ block.settings.text_padding_bottom | default: 0 | at_least: 0 }}px {{ block.settings.text_padding_left | default: 0 | at_least: 0 }}px;
        {%- endif %}
      }
    {%- endif %}
    {%- if el_has_color or block.settings.text_custom_margin %}
      #ColumnInfo-{{ block.id }} .multicolumn-card__text {
        {%- if el_has_color %}
          color: {{ el_color }};
        {%- endif %}
        {%- if block.settings.text_custom_margin %}
          margin: {{ block.settings.text_margin_top | default: 0 }}px {{ block.settings.text_margin_right | default: 0 }}px {{ block.settings.text_margin_bottom | default: 0 }}px {{ block.settings.text_margin_left | default: 0 }}px;
        {%- endif %}
      }
    {%- endif %}
    {%- if el_has_color %}
      #ColumnInfo-{{ block.id }} .multicolumn-card__text :is(p, ul, ol, li, a, strong, em) {
        color: {{ el_color }};
      }
    {%- endif %}
    {%- if block.settings.text_custom_font_size %}
      #ColumnInfo-{{ block.id }} .multicolumn-card__text, #ColumnInfo-{{ block.id }} .multicolumn-card__text :is(p, ul, ol, li) {
        font-size: {{ block.settings.text_font_size_mobile | divided_by: 10.0 }}rem;
      }
      @media screen and (min-width: 750px) {
        #ColumnInfo-{{ block.id }} .multicolumn-card__text, #ColumnInfo-{{ block.id }} .multicolumn-card__text :is(p, ul, ol, li) {
          font-size: {{ block.settings.text_font_size | divided_by: 10.0 }}rem;
        }
      }
    {%- endif %}
{%- endstyle -%}

{% stylesheet %}
  .multicolumn-list .multicolumn-card__title {
    width: fit-content;
    max-width: 100%;
  }

  .multicolumn-list .multicolumn-list-item.center .multicolumn-card__title {
    margin-left: auto;
    margin-right: auto;
  }

  .multicolumn-list .multicolumn-card__subheading--before {
    margin-bottom: 0.5rem;
  }

  .multicolumn-list .multicolumn-card__subheading--after {
    margin-top: 0.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.multicolumn.blocks.column.name",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.multicolumn.blocks.column.settings.image.label"
    },
    {
      "type": "checkbox",
      "id": "hide_image",
      "default": false,
      "label": "t:sections.multicolumn.blocks.column.settings.hide_image.label"
    },
    {
      "type": "video",
      "id": "video_url",
      "label": "t:sections.video-background.settings.video_url.label"
    },
    {
      "type": "checkbox",
      "id": "disable_autoplay",
      "default": false,
      "label": "Disable autoplay"
    },
    {
      "type": "text",
      "id": "title",
      "default": "Column",
      "label": "t:sections.multicolumn.blocks.column.settings.title.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.multicolumn.blocks.column.settings.subheading.label",
      "info": "t:sections.multicolumn.blocks.column.settings.subheading.info"
    },
    {
      "type": "select",
      "id": "subheading_position",
      "options": [
        {
          "value": "before",
          "label": "t:sections.multicolumn.blocks.column.settings.subheading_position.options__1.label"
        },
        {
          "value": "after",
          "label": "t:sections.multicolumn.blocks.column.settings.subheading_position.options__2.label"
        }
      ],
      "default": "after",
      "label": "t:sections.multicolumn.blocks.column.settings.subheading_position.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>",
      "label": "t:sections.multicolumn.blocks.column.settings.text.label"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:sections.multicolumn.blocks.column.settings.link_label.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.multicolumn.blocks.column.settings.link.label"
    },
    {
      "type": "checkbox",
      "id": "open_new_tab_1",
      "default": false,
      "label": "t:sections.all.open_new_tab.label"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.blocks.column.settings.header_title_style.content"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "t:sections.multicolumn.blocks.column.settings.color.label",
      "info": "t:sections.multicolumn.blocks.column.settings.color.info"
    },
    {
      "type": "checkbox",
      "id": "title_custom_font_size",
      "default": false,
      "label": "t:sections.multicolumn.blocks.column.settings.custom_font_size.label"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 22,
      "label": "t:sections.multicolumn.blocks.column.settings.font_size.label",
      "visible_if": "{{ block.settings.title_custom_font_size }}"
    },
    {
      "type": "range",
      "id": "title_font_size_mobile",
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 20,
      "label": "t:sections.multicolumn.blocks.column.settings.font_size_mobile.label",
      "visible_if": "{{ block.settings.title_custom_font_size }}"
    },
    {
      "type": "checkbox",
      "id": "title_custom_margin",
      "default": false,
      "label": "t:sections.multicolumn.blocks.column.settings.custom_margin.label"
    },
    {
      "type": "number",
