{% comment %}
  Renders a line icon for the trust bar.

  Accepts:
  - icon: {String} truck, shield, lock, stethoscope, card, check, heart, leaf

  Usage:
  {% render 'icon-trust', icon: 'shield' %}
{% endcomment %}

<svg
  class="trust-bar__svg"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'truck' -%}
      <path d="M8 6h7.5v10H8"/><path d="M15.5 9.5h3l2.5 3V16h-5.5"/><circle cx="10" cy="17" r="1.6"/><circle cx="18" cy="17" r="1.6"/><path d="M2 8h4M3 11h4M2 14h4"/>
    {%- when 'shield' -%}
      <path d="M12 2.8 5 5.5v5.6c0 4.4 3 8.3 7 9.9 4-1.6 7-5.5 7-9.9V5.5z"/><rect x="9.5" y="11" width="5" height="4" rx="0.8"/><path d="M10.5 11V9.8a1.5 1.5 0 0 1 3 0V11"/>
    {%- when 'lock' -%}
      <rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><path d="M12 14.5v2.5"/>
    {%- when 'stethoscope' -%}
      <path d="M6 3H5v5a4.5 4.5 0 0 0 9 0V3h-1"/><path d="M9.5 12.5v2a5 5 0 0 0 10 0v-2"/><circle cx="19.5" cy="10.5" r="2"/>
    {%- when 'card' -%}
      <rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/>
    {%- when 'check' -%}
      <circle cx="12" cy="12" r="9"/><path d="m8 12.2 2.7 2.7L16 9.5"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19 13 11"/>
  {%- endcase -%}
</svg>
