{
  "sections": {
    "main": {
      "type": "main-article",
      "blocks": {
        "featured-image": {
          "type": "_article-featured-image",
          "settings": {
            "image_height": "adapt"
          },
          "static": true
        },
        "title": {
          "type": "_article-title",
          "settings": {
            "blog_show_date": true,
            "blog_show_author": false
          }
        },
        "share": {
          "type": "_article-share",
          "settings": {
            "share_label": "Share"
          }
        },
        "content": {
          "type": "_article-content",
          "settings": {}
        },
        "tags": {
          "type": "_article-tags",
          "settings": {}
        },
        "buttons": {
          "type": "_article-navigation",
          "settings": {}
        }
      },
      "block_order": [
        "title",
        "share",
        "content",
        "tags",
        "buttons"
      ],
      "settings": {
        "color_scheme": "option-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
  },
  "order": [
    "main"
  ]
}
