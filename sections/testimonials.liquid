{{ 'section-testimonials.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 990px) {
    .margin-spacing-negative.section-{{ section.id }}-margin {
      margin-top: -{{ section.settings.margin_top }}px;
    }
    .margin-spacing-positive.section-{{ section.id }}-margin {
      margin-top: {{ section.settings.margin_top }}px;
    }
  }

  {%- if section.settings.section_background_color != blank and section.settings.section_background_color.alpha != 0 %}
    #TestimonialWrapper-{{ section.id }} {
      background: {{ section.settings.section_background_color }};
    }
  {%- endif %}

  #Testimonial-{{ section.id }} .testimonials .rating {
    color: {{ section.settings.rating_stars_color }};
  }

  #Testimonial-{{ section.id }} .testimonials svg.five-stars {
    width: {{ section.settings.rating_stars_width_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #Testimonial-{{ section.id }} .testimonials svg.five-stars {
      width: {{ section.settings.rating_stars_width }}px;
    }
  }

  {%- if section.settings.column_background_color != blank %}
    {%- if section.settings.testimonials_style == 'style-2' %}
      #Testimonial-{{ section.id }} .testimonials.content-container .grid-item.left {
        background: {{ section.settings.column_background_color }};
      }
      #Testimonial-{{ section.id }} .testimonials-image:before {
        border-top-color: {{ section.settings.column_background_color }};
      }
    {%- else %}
      #Testimonial-{{ section.id }} .testimonials.content-container {
        background: {{ section.settings.column_background_color }};
      }
    {%- endif %}
  {%- endif %}

  {%- liquid
    assign column_heading = '#Testimonial-' | append: section.id | append: ' .testimonial-text h3'
    assign column_subheading = '#Testimonial-' | append: section.id | append: ' .testimonial-text h4.subtitle'
    assign column_text = '#Testimonial-' | append: section.id | append: ' .testimonial-text .rte, #Testimonial-' | append: section.id | append: ' .testimonial-text .rte p'
  -%}

  {{ column_heading }} {
    {%- if section.settings.custom_column_heading_size %}
    font-size: {{ section.settings.column_heading_size_mobile }}px;
    {%- endif %}
    {%- if section.settings.column_heading_weight != 'default' %}
    font-weight: {{ section.settings.column_heading_weight }};
    {%- endif %}
    {%- if section.settings.column_heading_color != blank %}
    color: {{ section.settings.column_heading_color }};
    {%- endif %}
  }

  {{ column_subheading }} {
    {%- if section.settings.custom_column_subheading_size %}
    font-size: {{ section.settings.column_subheading_size_mobile }}px;
    {%- endif %}
    {%- if section.settings.column_subheading_weight != 'default' %}
    font-weight: {{ section.settings.column_subheading_weight }};
    {%- endif %}
    {%- if section.settings.column_subheading_color != blank %}
    color: {{ section.settings.column_subheading_color }};
    {%- endif %}
  }

  {{ column_text }} {
    {%- if section.settings.custom_column_text_size %}
    font-size: {{ section.settings.column_text_size_mobile }}px;
    {%- endif %}
    {%- if section.settings.column_text_weight != 'default' %}
    font-weight: {{ section.settings.column_text_weight }};
    {%- endif %}
    {%- if section.settings.column_text_color != blank %}
    color: {{ section.settings.column_text_color }};
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    {%- if section.settings.custom_column_heading_size %}
    {{ column_heading }} {
      font-size: {{ section.settings.column_heading_size }}px;
    }
    {%- endif %}
    {%- if section.settings.custom_column_subheading_size %}
    {{ column_subheading }} {
      font-size: {{ section.settings.column_subheading_size }}px;
    }
    {%- endif %}
    {%- if section.settings.custom_column_text_size %}
    {{ column_text }} {
      font-size: {{ section.settings.column_text_size }}px;
    }
    {%- endif %}
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider
    assign show_desktop_slider = true
  endif
-%}

<div id="TestimonialWrapper-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient ignore-{{ section.settings.ignore_spacing }}">
  <div class="{% if section.settings.title == blank %} no-heading{% endif %} testimonials-{{ section.settings.testimonials_style }} section-{{ section.id }}-padding {% if section.settings.swipe_on_mobile == false %}swipe-mobile-false{% endif %} margin-spacing-{{ section.settings.margin_spacing }} section-{{ section.id }}-margin">
    <div id="Testimonial-{{ section.id }}"
      class="testimonial-section page-width extract"
      data-aos="fade-up"
    >
      <slider-component class="slider-mobile-gutter {% if show_desktop_slider %} slider-component-desktop{% endif %}  {% if show_mobile_slider == true and show_desktop_slider == false  %} slider-buttons-desktop-hide{% endif %} {% if show_mobile_slider == false and show_desktop_slider == true  %} slider-buttons-mobile-hide{% endif %}">
        <div class="collection-info grid">
          <div class="grid_item">
            {%- unless section.settings.title == blank -%}
              <div class="testimonials-title">
                <p class="image-with-text-text image-with-text-text--caption {{ section.settings.text_style }} {{ section.settings.text_style }}--{{ section.settings.text_size }} {{ section.settings.text_style }}">
                  {{ section.settings.caption | escape }}
                </p>
                <{{ section.settings.heading_tag }} class="title {{ section.settings.heading_size }} heading-bold">
                  {{ section.settings.title | escape }}
                </{{ section.settings.heading_tag }}>
                {%- if section.settings.button_label != blank and show_mobile_slider -%}
                  <a href="{{ section.settings.button_link }}" {% if section.settings.open_new_tab_1 %} target="_blank" {% endif %} class="link underlined-link large-up-hide">
                    {{- section.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
            {%- endunless -%}
          </div>
          <div class="grid_item">
            {%- if show_mobile_slider or show_desktop_slider -%}
              <div class="disable-slider-arrows-{{ section.settings.disable_arrow_mobile }} slider-buttons no-js-hidden">
                <button
                  type="button"
                  class="slider-button slider-button--prev"
                  name="previous"
                  aria-label="{{ 'general.slider.previous_slide' | t }}"
                  aria-controls="Slider-{{ section.id }}"
                >
                  {% render 'icon-slider-arrows' %}
                </button>
                <button
                  type="button"
                  class="slider-button slider-button--next"
                  name="next"
                  aria-label="{{ 'general.slider.next_slide' | t }}"
                  aria-controls="Slider-{{ section.id }}"
                >
                  {% render 'icon-slider-arrows' %}
                </button>
              </div>
            {%- endif -%}
          </div>
        </div>
        <ul
          class="testimonials-list contains-content-container grid grid--1-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop {% if show_mobile_slider or show_desktop_slider %} slider{% if show_desktop_slider %} slider--desktop{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% endif %}"
          id="Slider-{{ section.id }}"
          data-aos="fade-up"
          role="list"
        >
          {%- liquid
            assign highest_ratio = 0
            for block in section.blocks
              if block.settings.image.aspect_ratio > highest_ratio
                assign highest_ratio = block.settings.image.aspect_ratio
              endif
            endfor
          -%}
          {% content_for 'blocks' %}
        </ul>
      </slider-component>
    </div>
    <div class="center{% if show_mobile_slider %} small-hide medium-hide{% endif %}" data-aos="fade-up">
      {%- if section.settings.button_label != blank -%}
        <a
          class="button-arrow button button--primary"
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}" {% if section.settings.open_new_tab_1 %} target="_blank" {% endif %}
          {% endif %}
        >
          {{ section.settings.button_label | escape }}
          {%- if settings.show_button_arrow -%}{% render 'icon-slider-arrows' %}{% endif %}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

