{%- liquid
  assign background_color = section.settings.background_color
  assign has_background_color = false
  if background_color != blank and background_color.alpha != 0
    assign has_background_color = true
  endif

  assign background_image = section.settings.background_image
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign background_position = section.settings.background_position | replace: '_', ' '
  assign image_style = 'object-fit: ' | append: section.settings.background_fit | append: '; object-position: ' | append: background_position | append: ';'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    {%- if section.settings.custom_padding_mobile %}
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    {%- else %}
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {%- endif %}
    margin-top: {{ section.settings.margin_top_mobile }}px;
    margin-bottom: {{ section.settings.margin_bottom_mobile }}px;
    {%- if has_background_color %}
      background: {{ background_color }};
    {%- endif %}
  }

  #BlocksSection-{{ section.id }} .blocks-section__inner > * + * {
    margin-top: {{ section.settings.blocks_gap_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }

    #BlocksSection-{{ section.id }} .blocks-section__inner > * + * {
      margin-top: {{ section.settings.blocks_gap }}px;
    }
  }
{%- endstyle -%}

<div
  id="BlocksSection-{{ section.id }}"
  class="blocks-section color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if background_image != blank %} blocks-section--has-image{% endif %}"
>
  {%- if section.settings.anchor_id != blank -%}
    <span id="{{ section.settings.anchor_id | handleize }}" class="blocks-section__anchor"></span>
  {%- endif -%}
  {%- if background_image != blank -%}
    <div class="blocks-section__media" aria-hidden="true">
      {{
        background_image
        | image_url: width: 3840
        | image_tag:
          class: 'blocks-section__image',
          loading: 'lazy',
          sizes: '100vw',
          widths: '750, 1100, 1500, 1780, 2000, 3000, 3840',
          alt: '',
          style: image_style
      }}
      {%- if overlay_opacity > 0 -%}
        <span
          class="blocks-section__overlay"
          style="background-color: {{ section.settings.overlay_color }}; opacity: {{ overlay_opacity }};"
        ></span>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="{% unless section.settings.full_width %}page-width{% else %}blocks-section--full-width{% endunless %}">
    <div class="blocks-section__inner blocks-section__inner--{{ section.settings.content_alignment }}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .blocks-section__anchor {
    display: block;
    scroll-margin-top: 80px;
  }

  .blocks-section--has-image {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .blocks-section__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .blocks-section__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .blocks-section__overlay {
    position: absolute;
    inset: 0;
  }

  .blocks-section--full-width {
    padding: 0 1.5rem;
  }

  .blocks-section__inner--left {
    text-align: left;
  }

  .blocks-section__inner--center {
    text-align: center;
  }

  .blocks-section__inner--right {
    text-align: right;
  }

  .blocks-section__inner > :is(h1, h2, h3, h4, h5, h6, p) {
    margin-bottom: 0;
  }

  @media screen and (min-width: 990px) {
    .blocks-section--full-width {
      padding: 0 5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.blocks-section.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:sections.blocks-section.settings.anchor_id.label",
      "info": "t:sections.blocks-section.settings.anchor_id.info"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.blocks-section.settings.full_width.label",
      "info": "t:sections.blocks-section.settings.full_width.info"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.blocks-section.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.blocks-section.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.blocks-section.settings.content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.blocks-section.settings.content_alignment.label"
    },
    {
      "type": "range",
      "id": "blocks_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.blocks-section.settings.blocks_gap.label"
    },
    {
      "type": "range",
      "id": "blocks_gap_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32,
      "label": "t:sections.blocks-section.settings.blocks_gap_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.header_color_box.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "option-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.blocks-section.settings.background_color.label",
      "info": "t:sections.blocks-section.settings.background_color.info"
    },
    {
      "type": "header",
      "content": "t:sections.blocks-section.settings.header_background_image.content"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.blocks-section.settings.background_image.label"
    },
    {
      "type": "select",
      "id": "background_position",
      "options": [
        {
          "value": "center",
          "label": "t:sections.blocks-section.settings.background_position.options__center.label"
        },
        {
          "value": "top",
          "label": "t:sections.blocks-section.settings.background_position.options__top.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.blocks-section.settings.background_position.options__bottom.label"
        },
        {
          "value": "left",
          "label": "t:sections.blocks-section.settings.background_position.options__left.label"
        },
        {
          "value": "right",
          "label": "t:sections.blocks-section.settings.background_position.options__right.label"
        },
        {
          "value": "top_left",
          "label": "t:sections.blocks-section.settings.background_position.options__top_left.label"
        },
        {
          "value": "top_right",
          "label": "t:sections.blocks-section.settings.background_position.options__top_right.label"
        },
        {
          "value": "bottom_left",
          "label": "t:sections.blocks-section.settings.background_position.options__bottom_left.label"
        },
        {
          "value": "bottom_right",
          "label": "t:sections.blocks-section.settings.background_position.options__bottom_right.label"
        }
      ],
      "default": "center",
      "label": "t:sections.blocks-section.settings.background_position.label",
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "select",
      "id": "background_fit",
      "options": [
        {
          "value": "cover",
          "label": "t:sections.blocks-section.settings.background_fit.options__cover.label"
        },
        {
          "value": "contain",
          "label": "t:sections.blocks-section.settings.background_fit.options__contain.label"
        },
        {
          "value": "fill",
          "label": "t:sections.blocks-section.settings.background_fit.options__fill.label"
        }
      ],
      "default": "cover",
      "label": "t:sections.blocks-section.settings.background_fit.label",
      "info": "t:sections.blocks-section.settings.background_fit.info",
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "header",
      "content": "t:sections.blocks-section.settings.header_overlay.content",
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "default": "#000000",
      "label": "t:sections.blocks-section.settings.overlay_color.label",
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0,
      "label": "t:sections.blocks-section.settings.overlay_opacity.label",
      "visible_if": "{{ section.settings.background_image != blank }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "custom_padding_mobile",
      "default": false,
      "label": "t:sections.blocks-section.settings.custom_padding_mobile.label",
      "info": "t:sections.blocks-section.settings.custom_padding_mobile.info"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.blocks-section.settings.padding_top_mobile.label",
      "default": 60,
      "visible_if": "{{ section.settings.custom_padding_mobile }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.blocks-section.settings.padding_bottom_mobile.label",
      "default": 60,
      "visible_if": "{{ section.settings.custom_padding_mobile }}"
    },
    {
      "type": "header",
      "content": "t:sections.blocks-section.settings.header_margin.content"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.blocks-section.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.blocks-section.settings.margin_bottom.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.blocks-section.settings.margin_top_mobile.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.blocks-section.settings.margin_bottom_mobile.label",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:sections.blocks-section.presets.blank_name"
    },
    {
      "name": "t:sections.blocks-section.presets.name",
      "settings": {
        "background_color": "#E3F4FD"
      },
      "blocks": {
        "header_row": {
          "type": "row",
          "settings": {
            "layout": "split",
            "vertical_alignment": "flex-end"
          },
          "blocks": {
            "header_left": {
              "type": "container",
              "settings": {
                "background_color": "rgba(0,0,0,0)",
                "border_radius": 0,
                "padding_vertical": 0,
                "padding_horizontal": 0,
                "padding_vertical_mobile": 0,
                "padding_horizontal_mobile": 0
              },
              "blocks": {
                "header_caption": {
                  "type": "caption",
                  "settings": {
